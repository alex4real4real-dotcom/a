(function () {function stamp(el) {if (el instanceof Element && !el.hasAttribute('data-ai-dynamic')) {el.setAttribute('data-ai-dynamic', '1');}}
function isModalVisible(el) {if (!(el instanceof Element)) return false;var style_obj = window.getComputedStyle(el);return style_obj.display !== 'none' && style_obj.visibility !== 'hidden';}
function isModalRoot(el) {if (!(el instanceof Element)) return false;if (el.getAttribute('role') === 'dialog') return true;var id_txt = el.id || '';return id_txt.length > 5 && id_txt.slice(-5) === 'Modal';}
function isModalChrome(el) {if (!(el instanceof Element)) return true;if (el.matches('button, input, select, textarea, label')) return true;if (el.closest('button')) return true;var onclick_txt = el.getAttribute('onclick') || '';var parent_btn_el = el.closest('button, a');if (parent_btn_el) {onclick_txt += parent_btn_el.getAttribute('onclick') || '';}
if (/close|dismiss|cancel/i.test(onclick_txt)) return true;if (el.matches('i.fa-times, i.fa-xmark, i.fa-close, .fa-times, .fa-xmark')) return true;if (el.matches('a[href]') && !el.hasAttribute('data-ai-db-field')) return true;return false;}
function isModalDbContentSlot(el, modal_el) {if (!(el instanceof Element) || isModalChrome(el)) return false;if (el.hasAttribute('data-ai-db-field')) return true;var id_txt = el.id || '';if (!id_txt) return false;var modal_id_txt = modal_el.id || '';if (modal_id_txt.length > 5 && modal_id_txt.slice(-5) === 'Modal') {var modal_prefix_txt = modal_id_txt.slice(0, -5);if (id_txt.indexOf(modal_prefix_txt) === 0 && id_txt.length > modal_prefix_txt.length) {return true;}}
if (/proj|record|item|data|title|desc|image|location|status/i.test(id_txt)) {var tag_txt = el.tagName ? el.tagName.toLowerCase() : '';if (tag_txt === 'img' || tag_txt === 'h1' || tag_txt === 'h2' || tag_txt === 'h3'
|| tag_txt === 'h4' || tag_txt === 'p' || tag_txt === 'span') {return true;}}
return false;}
function clearModalDbStamps(modal_el) {modal_el.removeAttribute('data-ai-namespace');modal_el.removeAttribute('data-ai-record-id');var stamped_els = modal_el.querySelectorAll('[data-ai-namespace], [data-ai-record-id]');for (var i = 0; i < stamped_els.length; i++) {stamped_els[i].removeAttribute('data-ai-namespace');stamped_els[i].removeAttribute('data-ai-record-id');}}
function clearModalDbContext() {var modals = document.querySelectorAll('[id$="Modal"], [role="dialog"]');for (var m = 0; m < modals.length; m++) {clearModalDbStamps(modals[m]);}}
