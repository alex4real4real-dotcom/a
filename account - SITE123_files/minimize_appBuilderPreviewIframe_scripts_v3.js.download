function propagateDbContextToVisibleModals(ns_txt, row_id_txt) {if (!ns_txt || !row_id_txt) return;var modals = document.querySelectorAll('[id$="Modal"], [role="dialog"]');for (var m = 0; m < modals.length; m++) {var modal_el = modals[m];if (!isModalVisible(modal_el)) continue;stampModalDbFields(modal_el, ns_txt, row_id_txt);}}
function start() {document.addEventListener('click', function (e) {var stamped_el = e.target && e.target.closest
? e.target.closest('[data-ai-namespace][data-ai-record-id]')
: null;if (!stamped_el) return;var ns_txt = stamped_el.getAttribute('data-ai-namespace') || '';var row_id_txt = stamped_el.getAttribute('data-ai-record-id') || '';if (!ns_txt || !row_id_txt) return;if (stamped_el.closest('[id$="Modal"], [role="dialog"]') && !isModalRoot(stamped_el)) {return;}
clearModalDbContext();propagateDbContextToVisibleModals(ns_txt, row_id_txt);setTimeout(function () {propagateDbContextToVisibleModals(ns_txt, row_id_txt);}, 50);}, true);new MutationObserver(function (mutations) {for (var i = 0; i < mutations.length; i++) {var added = mutations[i].addedNodes;for (var j = 0; j < added.length; j++) stamp(added[j]);}}).observe(document.body, { childList: true, subtree: true });}
if (document.readyState === 'loading') {document.addEventListener('DOMContentLoaded', start, { once: true });} else {start();}})();
