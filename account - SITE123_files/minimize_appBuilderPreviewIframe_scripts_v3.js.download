(function() {var seen = {};function makeKey(msg, stack) {return (msg || '') + '|' + (stack || '').substring(0, 200);}
function urlToProjectFile(url_txt) {var url_obj;try {url_obj = new URL(url_txt);} catch(e) {return null;}
var path_txt = url_obj.pathname;var asset_match_arr = path_txt.match(/^\/manager\/ai_app_builder\/assets\/(.+)$/);if (asset_match_arr) return asset_match_arr[1];var preview_match_arr = path_txt.match(/^\/\.preview-[a-f0-9]+(?:\/v\d+)?(?:\/\.l\/[^/]+)?\/?(.*)$/);if (preview_match_arr) return preview_match_arr[1] || 'index.html';return null;}
