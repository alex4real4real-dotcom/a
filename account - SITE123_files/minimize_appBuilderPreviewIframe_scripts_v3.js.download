var prevOnError = window.onerror;window.onerror = function(msg, src, line, col, err) {var stack = (err && err.stack) ? err.stack : '';var src_hint_txt = '';if (src) {src_hint_txt = src;if (line) {src_hint_txt += ':' + line + (col ? ':' + col : '');}}
