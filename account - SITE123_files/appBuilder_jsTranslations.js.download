translations.aiAppBuilder = {"selectedElement": "\u0627\u0644\u0639\u0646\u0635\u0631 \u0627\u0644\u0645\u062d\u062f\u062f","weFoundABugtofix": "\u064a\u062d\u062a\u0648\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u062c\u0628 \u0625\u0635\u0644\u0627\u062d\u0647\u0627:","weFoundABug": "\u0648\u062c\u062f\u0646\u0627 \u062e\u0637\u0623\u064b","weFoundBugs": "\u0648\u062c\u062f\u0646\u0627","bugs": "\u0623\u062e\u0637\u0627\u0621","serverFuncFailedSingular": "\u0641\u0634\u0644\u062a \u0648\u0638\u064a\u0641\u0629 \u0639\u0644\u0649 \u0627\u0644\u062e\u0627\u062f\u0645","serverFuncFailedPluralPrefix": "\u0648\u062c\u062f\u0646\u0627","serverFuncFailedPluralSuffix": "\u0641\u0634\u0644\u062a \u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u062e\u0627\u062f\u0645","startBuilding": "\u0627\u0628\u062f\u0623 \u0627\u0644\u0628\u0646\u0627\u0621","createOrSelectProject": "\u0635\u0650\u0641 \u0645\u0627 \u062a\u0631\u064a\u062f \u0625\u0646\u0634\u0627\u0621\u0647 \u0648\u0633\u0623\u064f\u0646\u0634\u0626 \u0644\u0643 \u0627\u0644\u0643\u0648\u062f.","describeWhatYouWantToBuild": "\u0635\u0650\u0641 \u0645\u0627 \u062a\u0631\u064a\u062f \u0625\u0646\u0634\u0627\u0621\u0647...","version": "\u0627\u0644\u0625\u0635\u062f\u0627\u0631","syncingFilesToAI": "\u062c\u0627\u0631\u064d \u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0625\u0644\u0649 AI... \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631.","submitAnswers": "\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u062c\u0627\u0628\u0627\u062a","fileTooLarge": "\u0627\u0644\u0645\u0644\u0641 \u0643\u0628\u064a\u0631 \u062c\u062f\u064b\u0627","couldNotUploadImage": "\u062a\u0639\u0630\u0651\u0631 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u0631\u0629.","failedToUploadImage": "\u0641\u0634\u0644 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0648\u0631\u0629.","uploadFailed": "\u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u0645\u064a\u0644","file": "\u0645\u0644\u0641","isTooLarge": "\u0643\u0628\u064a\u0631 \u062c\u062f\u064b\u0627. \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u062d\u062c\u0645 \u0647\u0648","tooManyAttachments": "\u0645\u0631\u0641\u0642\u0627\u062a \u0643\u062b\u064a\u0631\u0629 \u062c\u062f\u064b\u0627","tooManyAttachmentsText": "\u064a\u0645\u0643\u0646\u0643 \u0625\u0631\u0641\u0627\u0642 \u0645\u0627 \u064a\u0635\u0644 \u0625\u0644\u0649 {{max_files}} \u0645\u0644\u0641\u0627\u062a \u0644\u0643\u0644 \u0631\u0633\u0627\u0644\u0629. \u064a\u064f\u0631\u062c\u0649 \u0625\u0632\u0627\u0644\u0629 \u0628\u0639\u0636 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0642\u0628\u0644 \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f.","messageTooLong": "\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0637\u0648\u064a\u0644\u0629 \u062c\u062f\u064b\u0627","messageTooLongTextBeforeMax": "\u0631\u0633\u0627\u0644\u062a\u0643 \u0637\u0648\u064a\u0644\u0629 \u062c\u062f\u064b\u0627. \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0647\u0648","messageTooLongTextBetweenMaxAndCurrent": "\u062d\u0631\u0641\u060c \u0628\u064a\u0646\u0645\u0627 \u0643\u062a\u0628\u062a","selectAll": "\u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0643\u0644","unselectAll": "\u0625\u0644\u063a\u0627\u0621 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0643\u0644","skip": "\u062a\u062e\u0637\u064d\u0651","next": "\u0627\u0644\u062a\u0627\u0644\u064a","previous": "\u0627\u0644\u0633\u0627\u0628\u0642","other": "\u0627\u0644\u0623\u062e\u0631\u0649","skippedAnswer": "\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a","typeYourAnswer": "\u0627\u0643\u062a\u0628 \u0625\u062c\u0627\u0628\u062a\u0643...","thinkingAboutRequest": "\u0623\u0641\u0643\u0631 \u0641\u064a \u0627\u0644\u0637\u0644\u0628","analyzingExistingCode": "\u0642\u0631\u0627\u0621\u0629 \u0648\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0643\u0648\u062f \u0627\u0644\u062d\u0627\u0644\u064a \u0627\u0644\u062e\u0627\u0635 \u0628\u0643","updatingProjectFiles": "\u062a\u062d\u062f\u064a\u062b \u0645\u0644\u0641\u0627\u062a \u0645\u0634\u0631\u0648\u0639\u0643","improvingDesignDetails": "\u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0648\u0627\u0644\u062a\u062e\u0637\u064a\u0637","testingCodeBeforeFinish": "\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0643\u0648\u062f \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621","polishingFinalTouches": "\u0635\u0642\u0644 \u0627\u0644\u0644\u0645\u0633\u0627\u062a \u0627\u0644\u0623\u062e\u064a\u0631\u0629","connectingTheParts": "\u0631\u0628\u0637 \u0643\u0644 \u0634\u064a\u0621 \u0645\u0639\u064b\u0627","almostThereFinalizing": "\u0623\u0648\u0634\u0643\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 - \u0646\u064f\u0646\u062c\u0632 \u0627\u0644\u0644\u0645\u0633\u0627\u062a \u0627\u0644\u0623\u062e\u064a\u0631\u0629","takingLongerThanUsual": "\u0647\u0630\u0627 \u064a\u0633\u062a\u063a\u0631\u0642 \u0648\u0642\u062a\u064b\u0627 \u0623\u0637\u0648\u0644 \u0642\u0644\u064a\u0644\u064b\u0627 \u0645\u0646 \u0627\u0644\u0645\u0639\u062a\u0627\u062f - \u0645\u0627 \u0632\u0644\u0646\u0627 \u0646\u0639\u0645\u0644 \u0639\u0644\u0649 \u0630\u0644\u0643","stillWorkingOnRequest": "\u0645\u0627 \u0632\u0644\u0646\u0627 \u0646\u0639\u0645\u0644 \u0639\u0644\u0649 \u0637\u0644\u0628\u0643. \u0642\u062f \u062a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0639\u0642\u0651\u062f\u0629 \u0628\u0636\u0639 \u062f\u0642\u0627\u0626\u0642","thanksForPatienceStillBuilding": "\u0634\u0643\u0631\u064b\u0627 \u0644\u0635\u0628\u0631\u0643 \u2014 \u0645\u0627 \u0632\u0644\u0646\u0627 \u0646\u064f\u062c\u0631\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a\u0643","takingTooLongSplitSuggestion": "\u0639\u0630\u0631\u064b\u0627\u060c \u0647\u0630\u0627 \u064a\u0633\u062a\u063a\u0631\u0642 \u0648\u0642\u062a\u064b\u0627 \u0623\u0637\u0648\u0644 \u0628\u0643\u062b\u064a\u0631 \u0645\u0645\u0627 \u062a\u0648\u0642\u0639\u0646\u0627. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \"\u0625\u064a\u0642\u0627\u0641\" \u0648\u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0637\u0644\u0628 \u0625\u0644\u0649 \u0645\u0647\u0627\u0645 \u0623\u0635\u063a\u0631","openDataManager": "\u0627\u0641\u062a\u062d \u0645\u062f\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a","openTableSettings": "\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062c\u062f\u0648\u0644","openNamedTableSettings": "\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062c\u062f\u0648\u0644 {{name}}","setUpPaymentMethods": "\u0625\u0639\u062f\u0627\u062f \u0637\u0631\u0642 \u0627\u0644\u062f\u0641\u0639","openSupportCenter": "\u0641\u062a\u062d \u0645\u0631\u0643\u0632 \u0627\u0644\u062f\u0639\u0645","openDomainSettings": "\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0637\u0627\u0642","openStaffMembers": "\u0641\u062a\u062d \u0623\u0639\u0636\u0627\u0621 \u0641\u0631\u064a\u0642 \u0627\u0644\u0639\u0645\u0644","openSeoAudit": "\u0641\u062a\u062d \u062a\u062f\u0642\u064a\u0642 SEO","openSeoTools": "\u0641\u062a\u062d SEO","openStatistics": "\u0641\u062a\u062d \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a","openTaxSettings": "\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0636\u0631\u064a\u0628\u0629","openMailboxes": "\u0641\u062a\u062d \u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a","openUserCredits": "\u0641\u062a\u062d \u0627\u0644\u0623\u0631\u0635\u062f\u0629","openVersionHistory": "\u0641\u062a\u062d \u0633\u062c\u0644 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a","upgradeFromChat": "\u062a\u0631\u0642\u064a\u0629","startingWritingCodeEstimate": "\u0628\u062f\u0621 \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0643\u0648\u062f. \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0642\u062f\u0631: {time}","openAppBuilderSettings": "\u0627\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0646\u0634\u0626 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a","openServerFunctions": "\u0641\u062a\u062d \u062f\u0648\u0627\u0644 \u0627\u0644\u062e\u0627\u062f\u0645","openScheduledFunctions": "\u0641\u062a\u062d \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u0645\u062c\u062f\u0648\u0644\u0629","openConnectors": "\u0641\u062a\u062d \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0625\u0636\u0627\u0641\u0627\u062a","gettingMoreData": "\u062c\u0645\u0639 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062d\u0648\u0644 \u0645\u0634\u0631\u0648\u0639\u0643 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u0637\u0644\u0628","continueWritingCode": "\u062c\u0627\u0631\u064d \u0645\u062a\u0627\u0628\u0639\u0629 \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0643\u0648\u062f","validatingChanges": "\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a","finalizingChanges": "\u062c\u0627\u0631\u064d \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u0635\u0644\u0627\u062d\u0627\u062a","resolvingMediaAssets": "\u062c\u0627\u0631\u064d \u062a\u062d\u062f\u064a\u062f \u0623\u0635\u0648\u0644 \u0627\u0644\u0648\u0633\u0627\u0626\u0637","generatingCustomMedia": "\u062c\u0627\u0631\u064d \u0625\u0646\u0634\u0627\u0621 \u0648\u0633\u0627\u0626\u0637 \u0645\u062e\u0635\u0651\u0635\u0629","savingChanges": "\u062c\u0627\u0631\u064d \u062d\u0641\u0638 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a","Loadingversions": "\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a...","preview": "\u0645\u0639\u0627\u064a\u0646\u0629","restore": "\u0627\u0633\u062a\u0639\u0627\u062f\u0629","versionRestoreDataNote": "\u0644\u0627 \u062a\u062a\u0623\u062b\u0631 \u0633\u062c\u0644\u0627\u062a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0646\u062f \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0625\u0635\u062f\u0627\u0631 \u0633\u0627\u0628\u0642 - \u062a\u062a\u0645 \u0625\u0639\u0627\u062f\u0629 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u0642\u0637 \u0625\u0644\u0649 \u062d\u0627\u0644\u062a\u0647\u0627 \u0627\u0644\u0633\u0627\u0628\u0642\u0629.","restoreVersionTitle": "\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0625\u0635\u062f\u0627\u0631","restoreVersionConfirm": "\u0633\u064a\u0624\u062f\u064a \u0630\u0644\u0643 \u0625\u0644\u0649 \u0625\u0646\u0634\u0627\u0621 \u0625\u0635\u062f\u0627\u0631 \u062c\u062f\u064a\u062f \u0628\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u064f\u0633\u062a\u0639\u0627\u062f.","failedToRestore": "\u0641\u0634\u0644\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0625\u0635\u062f\u0627\u0631","restoredToVersion": "\u062a\u0645\u062a \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0625\u0635\u062f\u0627\u0631","versionLabel": "\u0627\u0644\u0625\u0635\u062f\u0627\u0631","restoring": "\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629...","revertToHistory": "\u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0625\u0635\u062f\u0627\u0631 \u0633\u0627\u0628\u0642","selectProjectFirst": "\u064a\u0631\u062c\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0634\u0631\u0648\u0639 \u0623\u0648\u0644\u0627\u064b","dbLoadingData": "\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a...","dbNoDataStoredYet": "\u0644\u0645 \u064a\u062a\u0645 \u062d\u0641\u0638 \u0623\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0639\u062f.","dbNoDataStoredHint": "\u064a\u0645\u0643\u0646 \u0644\u062a\u0637\u0628\u064a\u0642\u0643 \u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a (API) \u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.","dbFailedToLoadData": "\u0641\u0634\u0644 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a","dbNamespace": "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0627\u0633\u0645","dbSelectEmpty": "\u2014","dbAddRecordTitle": "\u0625\u0636\u0627\u0641\u0629 \u0633\u062c\u0644","dbSave": "\u062d\u0641\u0638","dbCancel": "\u0625\u0644\u063a\u0627\u0621","dbDelete": "\u062d\u0630\u0641","dbDataJsonLabel": "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a (JSON)","dbSelectNamespaceFirst": "\u064a\u0631\u062c\u0649 \u062a\u062d\u062f\u064a\u062f \u0645\u0633\u0627\u062d\u0629 \u0623\u0633\u0645\u0627\u0621 \u0623\u0648\u0644\u064b\u0627.","dbFailedToAddRecord": "\u0641\u0634\u0644\u062a \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0633\u062c\u0644","dbNoRecordsInNamespace": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0633\u062c\u0644\u0627\u062a \u0636\u0645\u0646 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0647\u0630\u0647.","dbNoRecordsInNamespaceHint": "\u063a\u064a\u0651\u0631 \u0639\u0627\u0645\u0644 \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0623\u0648 \u0623\u0636\u0641 \u0633\u062c\u0644\u064b\u0627.","dbDefaultNamespace": "(\u0627\u0641\u062a\u0631\u0627\u0636\u064a)","dbGlobalUserScope": "(\u0639\u0627\u0644\u0645\u064a)","dbSaving": "\u062d\u0641\u0638...","dbSavedShort": "\u062a\u0645 \u0627\u0644\u062d\u0641\u0638!","dbInva