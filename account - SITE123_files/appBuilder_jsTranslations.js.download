sgLogCoderPending": "\u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u2026","msgLogRouteCost": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0633\u0627\u0631","msgLogCoderCost": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u064f\u0628\u0631\u0645\u062c","msgLogFileRelevanceCost": "\u062a\u0643\u0644\u0641\u0629 \u0645\u0631\u062d\u0644\u0629 File Relevance","msgLogExplainReviewerCost": "\u062a\u0643\u0644\u0641\u0629 Explain Reviewer","msgLogAdvisorCost": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631","msgLogCombinedCost": "\u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629","msgLogProviderCost": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0632\u0648\u0651\u062f","msgLogCostTileRoute": "\u0627\u0644\u062a\u0648\u062c\u064a\u0647","msgLogCostTileCoder": "\u0627\u0644\u0645\u0628\u0631\u0645\u062c","msgLogCostTileFileRelevance": "\u0635\u0644\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a","msgLogCostTileExplainReviewer": "\u0645\u0631\u0627\u062c\u0639 \u0627\u0644\u0634\u0631\u0648\u062d\u0627\u062a","msgLogCostTileAdvisor": "\u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631","msgLogCostTileCombined": "\u0645\u064f\u062c\u0645\u064e\u0651\u0639","credits": "\u0627\u0644\u0623\u0631\u0635\u062f\u0629","msgLogCreditsFormulaCredit": "\u0631\u0635\u064a\u062f","msgLogCreditsFormulaCost": "\u0627\u0644\u062a\u0643\u0644\u0641\u0629","msgLogCreditsFormulaUserPackage": "\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645","messageCreditsTooltip": "\u0643\u0644\u0651\u0641\u062a \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 {{credits}} \u0631\u0635\u064a\u062f\u064b\u0627","msgLogRouteDuration": "\u0645\u062f\u0629 \u0627\u0644\u0645\u0633\u0627\u0631","msgLogCoderDuration": "\u0645\u062f\u0629 Coder","msgLogFileRelevanceDuration": "\u0645\u062f\u0629 \u0645\u0631\u062d\u0644\u0629 \u0645\u0644\u0627\u0621\u0645\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a","msgLogExplainReviewerDuration": "\u0645\u062f\u0629 \u0645\u0631\u062d\u0644\u0629 Explain Reviewer","msgLogAdvisorDuration": "\u0645\u062f\u0629 \u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631","msgLogCombinedDuration": "\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629","msgLogTotalDuration": "\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a","msgLogDurationGap": "\u0648\u0642\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062e\u0627\u062f\u0645","msgLogDurationCheck": "\u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u062a\u0648\u0642\u064a\u062a","msgLogPrePlannerSetup": "\u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0623\u0648\u0644\u064a (\u062a\u062d\u0645\u064a\u0644 \u0633\u062c\u0644 \u0627\u0644\u062f\u0631\u062f\u0634\u0629\u060c \u0648\u062d\u0644 \u0637\u0628\u0642\u0629 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0648\u0627\u0644\u0645\u0634\u0631\u0648\u0639)","msgLogLoadS3Prep": "\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u062c\u0645\u064a\u0639 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0645\u0646 \u0627\u0644\u062a\u062e\u0632\u064a\u0646","msgLogPreRouteContext": "\u0625\u0639\u062f\u0627\u062f \u0633\u064a\u0627\u0642 \u0627\u0644\u0637\u0644\u0628 \u0642\u0628\u0644 \u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 Planner AI","msgLogCoderJobPrepare": "\u0625\u0646\u0634\u0627\u0621 \u062d\u0645\u0648\u0644\u0629 \u0637\u0644\u0628 Coder AI","msgLogCoderRequestEncodePersist": "\u062a\u0631\u0645\u064a\u0632 \u0637\u0644\u0628 Coder AI \u0648\u062d\u0641\u0638\u0647 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a","msgLogLambdaDispatch": "\u062c\u0627\u0631\u064d \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u0647\u0645\u0629 \u0625\u0644\u0649 Lambda","msgLogLocalRunnerWait": "\u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0628\u062f\u0621 \u0645\u064f\u0634\u063a\u0651\u0644 \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u062d\u0644\u064a (\u0641\u064a \u0628\u064a\u0626\u0629 \u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0641\u0642\u0637)","msgLogQueueWait": "\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0633\u062a\u063a\u0631\u0642 \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0637\u0627\u0628\u0648\u0631 \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0642\u0628\u0644 \u0628\u062f\u0621 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629","msgLogLambdaAsyncHandoff": "\u0641\u062c\u0648\u0627\u062a \u063a\u064a\u0631 \u0645\u062a\u0632\u0627\u0645\u0646\u0629 \u0642\u0628\u0644 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 (\u0628\u062f\u0621 \u062a\u0634\u063a\u064a\u0644 Lambda \u0639\u0644\u0649 \u0627\u0644\u0628\u0627\u0631\u062f\u060c \u0642\u0627\u0626\u0645\u0629 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0625\u0631\u0633\u0627\u0644\u060c \u062a\u0633\u0644\u064a\u0645 webhook)","msgLogDispatchLagMeasured": "\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a \u0645\u0646 \u0628\u062f\u0621 \u0627\u0644\u0645\u0647\u0645\u0629 \u062d\u062a\u0649 Coder Lambda (\u062a\u0628\u062f\u0623 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0645\u0628\u0627\u0634\u0631\u0629\u064b \u0628\u0639\u062f \u0630\u0644\u0643)","msgLogCoderRequestDataBytes": "\u062d\u062c\u0645 \u062d\u0645\u0648\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u062e\u0632\u0651\u064e\u0646\u0629","msgLogCoderRequestAttachFiles": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u0631\u0641\u0642\u0629 \u0625\u0644\u0649 AI \u0627\u0644\u062e\u0627\u0635 \u0628\u0640 Coder","msgLogRouteResponseParse": "\u062a\u062d\u0644\u064a\u0644 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 AI \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0640 Planner \u0648\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062a\u0648\u0643\u0646\u0627\u062a\/\u0627\u0644\u062a\u0643\u0644\u0641\u0629","msgLogMediaGenerationAi": "MediaGenerationAI \u064a\u062e\u0637\u0651\u0637 \u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0645\u062e\u0635\u0651\u0635\u0629 \u0644\u0644\u0635\u0648\u0631\/\u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0628\u0647\u062f\u0641 \u062a\u0623\u0643\u064a\u062f\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u062f\u0631\u062f\u0634\u0629","msgLogChatMediaGeneration": "\u0625\u0646\u0634\u0627\u0621 \u0645\u0639\u0627\u064a\u0646\u0627\u062a \u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0644\u062a\u0623\u0643\u064a\u062f\u0647\u0627 \u0639\u0628\u0631 \u0627\u0644\u062f\u0631\u062f\u0634\u0629","msgLogChatMediaVideoPoll": "\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642 \u0628\u0634\u0643\u0644 \u0645\u062a\u0643\u0631\u0631 \u0645\u0646 \u0645\u0647\u0627\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0642\u064a\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u062d\u062a\u0649 \u062a\u0635\u0628\u062d \u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0627\u062a \u062c\u0627\u0647\u0632\u0629","msgLogChatMediaGenerationItems": "\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0648\u0633\u0627\u0626\u0637 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629","msgLogChatMediaGenerationImages": "\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0645\u0639\u0627\u064a\u0646\u0627\u062a \u0627\u0644\u0635\u0648\u0631","msgLogChatMediaGenerationVideos": "\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0623\u0648 \u0625\u0646\u0634\u0627\u0621 \u0645\u0639\u0627\u064a\u0646\u0627\u062a \u0627\u0644\u0641\u064a\u062f\u064a\u0648","msgLogPlanHandoff": "\u062c\u0627\u0631\u064d \u062a\u062c\u0647\u064a\u0632 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0637\u0629\/\u0627\u0644\u0633\u0624\u0627\u0644 \u0644\u0644\u062a\u062e\u0632\u064a\u0646","msgLogPreCoderWorker": "\u0628\u062f\u0621 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0639\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0644\u062e\u0627\u062f\u0645","msgLogPlanSave": "\u062d\u0641\u0638 \u0631\u062f \u0627\u0644\u062e\u0637\u0629\/\u0627\u0644\u0633\u0624\u0627\u0644 \u0648\u062a\u062d\u062f\u064a\u062b \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0629","msgLogPreCoderAttach": "\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u062a\u064a \u0633\u064a\u062a\u0645 \u0625\u0631\u0633\u0627\u0644\u0647\u0627 \u0625\u0644\u0649 Coder AI","msgLogCoderOpenRouterLambda": "Lambda \u0641\u064a OpenRouter \u062a\u064f\u0634\u063a\u0651\u0650\u0644 \u0637\u0644\u0628 Coder AI","msgLogLambdaGetRequest": "Lambda \u064a\u0642\u0648\u0645 \u0628\u062a\u062d\u0645\u064a\u0644 \u0637\u0644\u0628 Coder AI \u0645\u0646 \u0627\u0644\u062e\u0627\u062f\u0645","msgLogOpenRouterFailedAttempts": "\u0645\u062d\u0627\u0648\u0644\u0627\u062a OpenRouter \u0627\u0644\u0641\u0627\u0634\u0644\u0629 \u062f\u0627\u062e\u0644 Lambda","msgLogOpenRouterRetrySleep": "\u0641\u062a\u0631\u0627\u062a \u0627\u0644\u062a\u0623\u062e\u064a\u0631 \u0628\u064a\u0646 \u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0641\u064a OpenRouter \u062f\u0627\u062e\u0644 Lambda","msgLogLambdaCompletionWebhook": "\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0625\u0643\u0645\u0627\u0644 \u0641\u064a PHP \u0623\u062b\u0646\u0627\u0621 \u0627\u0646\u062a\u0638\u0627\u0631 Lambda","msgLogLambdaTotalWall": "\u0625\u062c\u0645\u0627\u0644\u064a \u0632\u0645\u0646 \u0627\u0644\u062c\u062f\u0627\u0631 \u0644\u0640 Lambda","msgLogOpenRouterAttempts": "\u0645\u062d\u0627\u0648\u0644\u0627\u062a OpenRouter \u062f\u0627\u062e\u0644 Lambda","msgLogOpenRouterAttemptSuccess": "\u0646\u062c\u0627\u062d","msgLogOpenRouterAttemptFailed": "\u0641\u0634\u0644","msgLogCoderOpenRouterAttempt": "\u0645\u062d\u0627\u0648\u0644\u0629 OpenRouter \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0640 Coder","msgLogCoderModelSavedResponse": "\u0646\u0645\u0648\u0630\u062c Coder (\u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0645\u062d\u0641\u0648\u0638\u0629)","msgLogCoderToolS3": "\u064a\u0642\u0648\u0645 AI \u0627\u0644\u062e\u0627\u0635 \u0628\u0640 Coder \u0628\u062c\u0644\u0628 \u0645\u0644\u0641\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \/ \u0628\u064a\u0627\u0646\u0627\u062a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629","msgLogStructureRepairAi": "\u0627\u0633\u062a\u062f\u0639\u0627\u0621 AI \u0645\u0646 \u0646\u0641\u0633 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u0625\u0635\u0644\u0627\u062d \u0628\u0646\u064a\u0629 \u0639\u0644\u0627\u0645\u0629 \u0625\u0643\u0645\u0627\u0644 Coder","msgLogEmitCodeRetryAi": "\u0627\u0633\u062a\u062f\u0639\u0627\u0621 AI \u0625\u0636\u0627\u0641\u064a \u0644\u0625\u0639\u0627\u062f\u0629 \u0625\u062e\u0631\u0627\u062c \u0627\u0644\u0643\u0648\u062f \u0627\u0644\u0630\u064a \u0648\u0635\u0641\u062a\u0647 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0643\u0646\u0647\u0627 \u0644\u0645 \u062a\u0643\u062a\u0628\u0647","msgLogPatchRetryAi": "\u0627\u0633\u062a\u062f\u0639\u0627\u0621 AI \u0625\u0636\u0627\u0641\u064a \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0635\u062d\u064a\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u0645 \u064a\u062a\u0645 \u062a\u0637\u0628\u064a\u0642\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649","msgLogExplainReviewerAi": "\u0634\u0631\u062d \u0623\u0646 AI \u0627\u0644\u062e\u0627\u0635 \u0628\u0640 Reviewer \u064a\u0643\u062a\u0628 \u0623\u0648\u0635\u0627\u0641 \u0627\u0644\u063a\u0631\u0636 \u0645\u0646 \u0627\u0644\u0645\u0644\u0641 \u0642\u0628\u0644 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u062d\u0629 \u0627\u0644\u0643\u0648\u062f","msgLogFileRelevanceAi": "AI \u0644\u0645\u062f\u0649 \u0635\u0644\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a: \u0627\u062e\u062a\u064a\u0627\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0647\u0645\u0629 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u0635\u0644\u0629 \u0642\u0628\u0644 PlannerAI","msgLogPostAiLint": "\u0641\u062d\u0648\u0635\u0627\u062a \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u062d\u0629 \u0627\u0644\u0643\u0648\u062f","msgLogLintFixLambda": "\u0625\u0635\u0644\u0627\u062d \u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u062d\u0629 \u0627\u0644\u0643\u0648\u062f \u0641\u064a OpenRouter Lambda","msgLogPostAiMedia": "\u062c\u0627\u0631\u064d \u0641\u062d\u0635 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u063a\u064a\u064a\u0631\u0647\u0627 \u0628\u062d\u062b\u064b\u0627 \u0639\u0646 \u0639\u0646\u0627\u0648\u064a\u0646 URL \u0644\u0644\u0648\u0633\u0627\u0626\u0637\/\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a \u0644\u0631\u0641\u0639\u0647\u0627 \u0648\u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 (\u064a\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a \u0625\u0630\u0627 \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0623\u064a\u0651 \u0645\u0646\u0647\u0627)","msgLogPostAiMediaScan": "\u062c\u0627\u0631\u064d \u0641\u062d\u0635 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u063a\u064a\u064a\u0631\u0647\u0627 \u0628\u062d\u062b\u064b\u0627 \u0639\u0646 \u0639\u0646\u0627\u0648\u064a\u0646 URL \u0644\u0644\u0648\u0633\u0627\u0626\u0637 \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u0628\u0626\u062a\u0647\u0627 \u0639\u0628\u0631 \u0645\u062d\u0644\u0651\u0644 \u0627\u0644\u0648\u0633\u0627\u0626\u0637","msgLogPostAiMediaFetch": "\u062c\u0627\u0631\u064d \u0627\u0633\u062a\u0631\u062c\u0627\u0639 \u0635\u0648\u0631 \u0648\u0645\u0642\u0627\u0637\u0639 \u0641\u064a\u062f\u064a\u0648 \u0633\u062a\u0648\u0643 \u0645\u0646 \u0645\u0632\u0648\u0651\u062f\u064a \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0648\u0633\u0627\u0626\u0637","msgLogPostAiMediaUpload": "\u062c\u0627\u0631\u064d \u0631\u0641\u0639 \u0648\u0633\u0627\u0626\u0637 \u0627\u0644\u0633\u062a\u0648\u0643 \u0627\u0644\u062a\u064a \u062a\u0645\u0651\u062a \u0645\u0639\u0627\u0644\u062c\u062a\u0647\u0627 \u0625\u0644\u0649 \u0634\u0628\u0643\u0629 CDN \u0648\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0639\u0646\u0627\u0648\u064a\u0646 URL \u0641\u064a \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u0639\u062f\u064a\u0644\u0647\u0627","msgLogPostAiMediaResolve": "\u0645\u0639\u0627\u0644\u062c\u0629 \u0648\u0633\u0627\u0626\u0637 \u0623\u062e\u0631\u0649 (\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u060c \u0627\u0644\u0635\u0648\u062a\u060c \u0645\u0631\u0641\u0642\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629)","msgLogPostAiMediaPlaceholderImages": "\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0635\u0648\u0631 \u0645\u0624\u0642\u062a\u0629","msgLogPostAiMediaPlaceholderVideos": "\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0642\u0627\u0637\u0639 \u0641\u064a\u062f\u064a\u0648 \u0645\u0624\u0642\u062a\u0629","msgLogPostAiMediaResolvedImages": "\u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0635\u0648\u0631","msgLogPostAiMediaResolvedVideos": "\u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648","msgLogPostAiMediaFailedImages": "\u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062e\u064a\u0627\u0631 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a","msgLogPostAiMediaFailedVideos": "\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0643\u062e\u064a\u0627\u0631 \u0627\u062d\u062a\u064a\u0627\u0637\u064a","msgLogPostAiMediaResolvedRemoveBg": "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0627\u062a","msgLogPostAiMediaResolvedSounds": "\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0624\u062b\u0631\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629","msgLogPostAiMediaResolvedMusic": "\u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u064a\u0629","msgLogPostAiMediaResolvedChatAttachments": "\u062a\u0645\u062a \u062a\u0631\u0642\u064a\u0629 \u0645\u0631\u0641\u0642\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629","msgLogPostAiDbOps": "\u062d\u0641\u0638 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0637\u0628\u064a\u0642\u0643","msgLogPostAiSaveFiles": "\u062c\u0627\u0631\u064d \u062d\u0641\u0638 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0643\u0648\u062f \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u062a\u062e\u0632\u064a\u0646","msgLogPostAiSnapshot": "\u062c\u0627\u0631\u064d \u0625