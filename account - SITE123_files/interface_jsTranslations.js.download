u0646\u0639\u0627\u0644\u062c \u0645\u0644\u0641\u0643. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u062d\u062a\u0649 \u064a\u0643\u062a\u0645\u0644 \u0627\u0644\u0631\u0641\u0639",},"insidePage": {"convertTitle": "\u062a\u062d\u0648\u064a\u0644 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645","convertQuestion": "\u0642\u0628\u0644 \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u060c \u0646\u0646\u0642\u0644 \u0623\u0648\u0644\u0627\u064b \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u062b\u0645 \u0646\u0636\u064a\u0641 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645. \u0633\u062a\u062e\u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621. \u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u061f",},"upgradeOptionMsg": "\u062e\u064a\u0627\u0631 \u0625\u062e\u0641\u0627\u0621 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0648\u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0645\u