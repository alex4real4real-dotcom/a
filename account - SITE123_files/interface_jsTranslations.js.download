46\u0629","NotRecognizeCityTooltip": "\u0644\u0645 \u062a\u062d\u062f\u062f \u0623\u062f\u0627\u0629 IP Locator \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 IP \u0627\u0644\u062e\u0627\u0635 \u0628\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.","NotRecognizeState": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0644\u0629","NotRecognizeStateTooltip": "\u0644\u0645 \u062a\u062d\u062f\u062f \u0623\u062f\u0627\u0629 IP Locator \u0627\u0644\u062f\u0648\u0644\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 IP \u0627\u0644\u062e\u0627\u0635 \u0628\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645.","wizardCookieReload": "\u064a\u062a\u0637\u0644\u0628 \u062a\u063a\u064a\u064a\u0631 \u0646\u0635 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 \u062a\u062d\u062f\u064a\u062b \u0645\u062a\u0635\u0641\u062d\u0643. \u0633\u0648\u0641 \u064a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0623\u0645\u0631 \u0628\u0636\u0639 \u062b\u0648\u0627\u0646.","eCommerce": {"title": "\u0627\u0644\u0645\u062a\u062c\u0631","pageNameCannotChange": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u063a\u064a\u064a\u0631 \u0627\u0633\u0645 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062a\u062c\u0631."	},"hidePageFromMenuToolTip": "\u0635\u0641\u062d\u062a\u0643 \u0645\u062e\u0641\u064a\u0629 \u0645\u0646 \u0631\u0623\u0633 \u0627\u0644\u0645\u0648\u0642\u0639. \u0627\u0646\u0642\u0631 \u0641\u0648\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631.","cpWizard": {"lm": {"title": "\u0627\u0644\u0644\u063a\u0627\u062a","titleToolTip": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062d\u0642\u0648\u0644 \u0644\u0643\u0644 \u0644\u063a\u0629","iconToolTip": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u0636\u0627\u0641\u0629 \u0648\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0644\u063a\u0627\u062a","modalTitle": "\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0644\u063a\u0627\u062a","label": "\u0627\u0644\u0644\u063a\u0629 \u0648\u0627\u0644\u0645\u0646\u0637\u0642\u0629","disabledLanguageToolTip": "\u0627\u0644\u0644\u063a\u0629 \u0645\u064f\u0641\u0639\u0651\u0644\u0629 \u0628\u0627\u0644\u0641\u0639\u0644","removeLanguage": "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0644\u063a\u0629","changeLanguagePlace": "\u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0645\u0643\u0627\u0646 \u0627\u0644\u0644\u063a\u0629 \u0647\u0630\u0627 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0633\u062d\u0628","languageNametableTh": "\u0627\u0633\u0645 \u0627\u0644\u0644\u063a\u0629","languageIcontableTh": "\u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0644\u063a\u0629","languageActiontableTh": "\u0639\u0645\u0644","addLanguage": "\u0625\u0636\u0627\u0641\u0629 \u0644\u063a\u0629","manageLanguages": "\u0625\u062f\u0627\u0631\u0629","proMessage": "\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629\u060c \u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0644\u063a\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629 \u0641\u064a \u0635\u0641\u062d\u062a\u0643. \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627\u060c \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 \u062e\u0637\u0629 \u0645\u0645\u064a\u0632\u0629.","proMessageUserExceeded": "\u0639\u062f\u062f \u0627\u0644\u0644\u063a\u0627\u062a \u0641\u064a \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u062d\u062f. \u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u0632\u0627\u0644\u0629 \u0628\u0639\u0636 \u0627\u0644\u0644\u063a\u0627\u062a \u0623\u0648 \u062a\u0631\u0642\u064a\u0629 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643.","proMessageNoLanguages": "\u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u062a\u064a \u0644\u062f\u064a\u0643 \u0644\u0627 \u062a\u062a\u0636\u0645\u0646 \u0644\u063a\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629\u061b \u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u063a\u0627\u062a\u060c \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0627\u0644\u062a\u0631\u0642\u064a\u0629.","proMessageLanguagesNotVisible": "\u0644\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0644\u063a\u0627\u062a \u0645\u0631\u0626\u064a\u0629 \u0644\u0644\u0632\u0648\u0627\u0631 \u062d\u062a\u0649 \u062a\u0642\u0648\u0645 \u0628\u062a\u0631\u0642\u064a\u0629 \u062e\u0637\u062a\u0643.",},"wizardFields": {"title": "\u0627\u0644\u0627\u0633\u0645","titleTooltip": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0643\u0627\u0631\u062f \u0628\u064a\u062c CardPage \u0627\u0644\u062e\u0627\u0635 \u0628\u0643","titlePlaceholder": "\u0627\u0633\u0645\u0643","subTitle": "\u0639\u0646\u0648\u0627\u0646 \u0641\u0631\u0639\u064a","subTitleTooltip": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a \u0644\u0635\u0641\u062d\u0629 \u0628\u0637\u0627\u0642\u062a\u0643","subTitleDef": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0631\u0639\u064a \u0644\u0644\u0643\u0627\u0631\u062f \u0628\u064a\u062c CardPage","subTitlePlaceholder": "\u0627\u0644\u0648\u0635\u0641 \u0627\u0644\u0648\u0638\u064a\u0641\u064a \u0648\u0627\u0644\u0634\u0639\u0627\u0631 \u0648\u0645\u0627 \u0625\u0644\u0649 \u0630\u0644\u0643.","about": "\u0646\u0635 \u0642\u0635\u064a\u0631 \u0644\u0640 \"\u062d\u0648