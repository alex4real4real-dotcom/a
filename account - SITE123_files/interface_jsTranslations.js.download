var translations = {"areYouSure": "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f\u061f","areYouSureCat": "\u0645\u0633\u062d \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0633\u064a\u0644\u063a\u0649 \u0623\u064a\u0636\u0627 \u062c\u0645\u064a\u0639 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u062a\u062d\u062a \u0647\u0630\u0647 \u0627\u0644\u0642\u0627\u0626\u0645\u0629\u060c \u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0647\u0630\u0647 \u0627\u0644\u0642\u0627\u0626\u0645\u0629\u061f","yes": "\u0646\u0639\u0645","no": "\u0644\u0627","add": "\u0625\u0636\u0627\u0641\u0629","title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646","manage": "\u0625\u062f\u0627\u0631\u0629","error": "\u062e\u0637\u0623","tryAgain": "\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649","edit": "\u062a\u062d\u0631\u064a\u0631","close": "\u0625\u063a\u0644\u0627\u0642","print": "\u0637\u0628\u0627\u0639\u0629","moveModule": "\u0646\u0642\u0644 \u0627\u0644\u0635\u0641\u062d\u0629","removeModule": "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0635\u0641\u062d\u0629","removePage": "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0635\u0641\u062d\u0629","removeCategory": "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0641\u0626\u0629","moduleSettings": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0629","pageSettings": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0629","showOnHomepage": "\u0648\u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629","hideFromMobile": "\u0625\u062e\u0641\u0627\u0621 \u0645\u0646 \u0627\u0644\u062c\u0648\u0627\u0644","hideFromMobileToolTip": "\u064a\u062d\u062f\u062f \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0645\u0648\u0644\u0629 \u0639\u0646\u062f \u0639\u0631\u0636 \u0627\u0644\u0635\u0641\u062d\u0629 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628. \u0633\u064a\u0638\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0642\u0627\u062f\u0631\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0631\u0623\u0633 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628.","chosenSelectMultiple": "\u0627\u0646\u0642\u0631 \u0644\u0644\u0627\u062e\u062a\u064a\u0627\u0631","showOnMenu": "\u0627\u0639\u0631\u0636 \u0639\u0644\u0649 \u0631\u0623\u0633 \u0627\u0644\u0645\u0648\u0642\u0639","showOnFooter": "\u0625\u0638\u0647\u0627\u0631 \u0641\u064a \u062a\u0630\u064a\u064a\u0644 \u0627\u0644\u0645\u0648\u0642\u0639","pagesDragToCatError": "\u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0648\u0636\u0639 \u0647\u0630\u0627 \u0627\u0644\u0639\u0646\u0635\u0631 \u062f\u0627\u062e\u0644 \u0641\u0626\u0629!","pagesDragToFirstError": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0641\u064a \u0623\u0639\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0625\u0644\u0627 \u0627\u0644\u0642\u0633\u0645 \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0623\u062c\u0632\u0627\u0621","pagesDragFromFirstError": "\u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u0642\u0649 \u0627\u0644\u0642\u0633\u0645 \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0623\u062c\u0632\u0627\u0621 \u0641\u064a \u0623\u0639\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629!","pagesDragLastMultiSectionError": "\u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0646\u0642\u0644 \u0622\u062e\u0631 \u0642\u0633\u0645 \u0645\u062a\u0639\u062f\u062f \u0625\u0644\u0649 \u0641\u0626\u0629. \u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u0642\u0649 \u0642\u0633\u0645 \u0645\u062a\u0639\u062f\u062f \u0648\u0627\u062d\u062f \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062c\u0630\u0631\u064a.","imageIsTooSmall": "\u0635\u0648\u0631\u062a\u0643 \u0635\u063a\u064a\u0631\u0629 \u062c\u062f\u064b\u0627.","uploadFailed": "\u0641\u0634\u0644 \u0627\u0644\u0631\u0641\u0639!","uploadFailedInvalidImage": "\u0645\u0644\u0641 \u0635\u0648\u0631\u0629 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d. \u0627\u0644\u0631\u062c\u0627\u0621 \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0623\u0648 \u062a\u062d\u0645\u064a\u0644 \u0635\u0648\u0631\u0629 \u0623\u062e\u0631\u0649.","sorryTheFileSize": "\u0639\u0630\u0631\u064b\u0627\u060c \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u062d\u0627\u0648\u0644 \u062a\u062d\u0645\u064a\u0644\u0647\u0627 \u0635\u063a\u064a\u0631\u0629 \u062c\u062f\u064b\u0627. \u0644\u0636\u0645\u0627\u0646 \u0639\u0631\u0636 \u0627\u0644\u0635\u0648\u0631\u0629 \u0628\u0634\u0643\u0644 \u0645\u062b\u0627\u0644\u064a \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u062c\u0647\u0632\u0629\u060c \u064a\u064f\u0631\u062c\u0649 \u062a\u062d\u0645\u064a\u0644 \u0635\u0648\u0631\u0629 \u0623\u0643\u0628\u0631 \u0628\u0623\u0628\u0639\u0627\u062f \u0644\u0627 \u062a\u0642\u0644 \u0639\u0646 {{minWidth}}x{{minHeight}}.","sorryTheFileSizeUploadBtn": "\u062a\u062d\u0645\u064a\u0644 \u0645\u0644\u0641 \u0622\u062e\u0631","sorryTheFileSizeLibraryBtn": "\u0627\u062e\u062a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0643\u062a\u0628\u0629","ok": "\u0645\u0648\u0627\u0641\u0642","Promo": "\u0627\u0644\u0639\u0631\u0648\u0636","headers": "\u0627\u0644\u0631\u0624\u0648\u0633","badRequest": "\u0637\u0644\u0628 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d","businessPackageOnly": "\u0639\u0630\u0631\u064b\u0627 \u060c \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0645\u062a\u0627\u062d \u0641\u0642\u0637 \u0644\u062d\u0627\u0645\u0644\u064a \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629. \u0627\u0646\u0642\u0631 \u0644\u0644\u062a\u0631\u0642\u064a\u0629.","fileSizeLimit": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u062d\u062c\u0645: {{mb}}\u0645\u064a\u063a\u0627\u0628\u0627\u064a\u062a\u061b","fileTypesLimit": "\u0627\u0644\u0623\u0646\u0648\u0627\u0639: {{acceptedFiles}}\u061b","upload": "\u0631\u0641\u0639","library": "\u0627\u0644\u0645\u0643\u062a\u0628\u0629","imagesLibrary": "\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0635\u0648\u0631","videoLibrary": "\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0641\u064a\u062f\u064a\u0648","takePhoto": "\u062a\u0635\u0648\u064a\u0631","patterns": "\u0623\u0646\u0645\u0627\u0637 - \u0631\u0633\u0645","addImageFilters": "\u0625\u0636\u0627\u0641\u0629 \u0645\u0631\u0634\u062d\u0627\u062a \u0644\u0644\u0635\u0648\u0631\u0629","imageFilters": "\u0645\u0631\u0634\u062d\u0627\u062a \u0627\u0644\u0635\u0648\u0631","cropTool": "\u0642\u0635 \u0627\u0644\u0635\u0648\u0631\u0647","imageEditor": "\u0645\u062d\u0631\u0631 \u0627\u0644\u0635\u0648\u0631","changeAssetsForMobile": "\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0644\u0644\u062c\u0648\u0627\u0644","focusPointDisabledMobileAssets": "\u064a\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0646\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0645\u0648\u0644\u0629","imageFocusPoint": "\u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u0631\u0643\u064a\u0632","videoFocusPoint": "\u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u0631\u0643\u064a\u0632","remove": "\u0625\u0632\u0627\u0644\u0629","fileUploadInProgress": "\u062c\u0627\u0631\u064a \u0631\u0641\u0639 \u0627\u0644\u0645\u0644\u0641!","pleaseEnterValidColor": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0631\u0645\u0632 \u0644\u0648\u0646 \u0635\u0627\u0644\u062d\u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 #fff \u0623\u0648 #ffffff (0-9\u060c AF\u060c \u0628\u0637\u0648\u0644 3 \u0623\u0648 6 \u0623\u062d\u0631\u0641)","pleaseEnterValidText": "\u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0646\u0635 \u0635\u0627\u0644\u062d \u0648\u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u0645\u0633\u0627\u0641\u0627\u062a","itemsCategories": "\u0627\u0644\u0641\u0626\u0627\u062a","pleaseEnterValidVideoYV": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0631\u0627\u0628\u0637 YouTube\/Vimeo \u0635\u0627\u0644\u062d\u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: \"https:\/\/www.youtube.com\/videoParameters\" \u0623\u0648 \"http:\/\/vimeo.com\/videoParameters\".","pleaseEnterValidVideoYV_Youtube": "\u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 URL \u0635\u0627\u0644\u062d \u0644\u0645\u0648\u0642\u0639 YouTube. \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u060c \"https:\/\/www.youtube.com\/videoParameters\"","pleaseEnterValidVideoYV_Vimeo": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0631\u0627\u0628\u0637 Vimeo \u0635\u0627\u0644\u062d (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: \"https:\/\/vimeo.com\/videoParameters\").","icons": "\u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a","logoMaker": "\u0635\u0627\u0646\u0639 \u0627\u0644\u0634\u0639\u0627\u0631","illustrations": "\u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0648\u0636\u064a\u062d\u064a\u0629","fieldRequired": "\u0647\u0630\u0627 \u0627\u0644\u062d\u0642\u0644 \u0645\u0637\u0644\u0648\u0628.","fieldMaxValue": "\u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0642\u064a\u0645\u0629 \u0623\u0642\u0644 \u0645\u0646 \u0623\u0648 \u064a\u0633\u0627\u0648\u064a \u0625\u0644\u0649 {0}.","styles_useMyText": "\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0646\u0635 \u0627\u0644\u062e\u0627\u0635 \u0628\u064a","styles_useMyTextExp": "\u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a\u060c \u0642\u062f \u0644\u0627 \u064a\u062a\u0648\u0627\u0641\u0642 \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0646\u0635 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0645\u0639 \u0627\u0644\u0646\u0645\u0637 \u0627\u0644\u0645\u062d\u062f\u062f. \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062a\u0648\u0627\u0641\u0642\u0647.","styles_useMyImage": "\u0627\u0633\u062a\u062e\u062f\u0645 \u0635\u0648\u0631\u062a\u064a","styles_useMyImageExp": "\u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a\u060c \u0642\u062f \u0644\u0627 \u062a\u062a\u0646\u0627\u0633\u0628 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0645\u0639 \u0627\u0644\u0646\u0645\u0637 \u0627\u0644\u0645\u062d\u062f\u062f. \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u062f\u0649 \u062a\u0648\u0627\u0641\u0642\u0647\u0627.","deleteWebsiteConfirmMsg": "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a {{websiteName}}\u061f","restoreWebsiteConfirmMsg": "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a {{websiteName}}\u061f","duplicateWebsiteConfirmMsg": "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0646\u0633\u062e \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a {{websiteName}}\u061f","pleaseEnterValidPhone": "\u0623\u062f\u062e\u0644 \u0645\u0646 \u0641\u0636\u0644\u0643 \u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0635\u062d\u064a\u062d (0-9, -, +, (), space, *)","pleaseEnterValidUrl": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 URL \u0635\u0627\u0644\u062d (\u0645\u062b\u0627\u0644: http:\/\/example.com).","urlsNotSupportedMsg": "\u0623\u0646\u0645\u0627\u0637 \u0639\u0646\u0648\u0627\u0646 URL \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0625\u062f\u062e\u0627\u0644. \u064a\u0631\u062c\u0649 \u062a\u0642\u062f\u064a\u0645 \u0642\u064a\u0645\u0629 \u0635\u0627\u0644\u062d\u0629.","pleaseEnterValidUrlWithHttps": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0639\u0646\u0648\u0627\u0646 URL \u0635\u0627\u0644\u062d \u064a\u0633\u062a\u062e\u062f\u0645 HTTPS (\u0645\u062b\u0644: https:\/\/example.com).","pleaseEnterDomainWithoutProtocol": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645 \u0646\u0637\u0627\u0642 \u0628\u062f\u0648\u0646 \u200ehttp:\/\/\u200e \u0623\u0648 \u200ehttps:\/\/\u200e (\u0645\u062b\u0644: app.example.com).","pleaseEnterValidTime": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0648\u0642\u062a \u0635\u0627\u0644\u062d.","pleaseEnterValidMoney": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0631\u0642\u0645 \u0635\u0627\u0644\u062d. \u064a\u0645\u0643\u0646 \u0625\u0636\u0627\u0641\u0629 \u0631\u0642\u0645\u064a\u0646 \u0641\u0642\u0637 \u0628\u0639\u062f \u0627\u0644\u0641\u0627\u0635\u0644\u0629 \u0627\u0644\u0639\u0634\u0631\u064a\u0629.","fileTypesErrorMsg": "\u0644\u0627 \u064a\u0645\u0643\u0646\u0643 \u0631\u0641\u0639 \u0645\u0644\u0641\u0627\u062a \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0646\u0648\u0639\u061b \u064a\u064f\u0631\u062c\u0649 \u0631\u0641\u0639 \u0627\u0644\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0641\u0642\u0637: {{acceptedFiles}}.","pleaseEnterValidHtml": "\u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0631\u0645\u0632 HTML \u0635\u0627\u0644\u062d\u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u060c \u0627\u0633\u062a\u062e\u062f\u0645 &lt;script&gt;  \u0644\u0627\u0644\u062a\u0641\u0627\u0641 \u0646\u0635 JS","design": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645","choosePageLayout": "\u0627\u062e\u062a\u0631 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0635\u0641\u062d\u0629","chooseLayoutContent": "\u0627\u062e\u062a\u0631 \u0634\u0643\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649","addNewPage": "\u0625\u0636\u0627\u0641\u0629 \u0635\u0641\u062d\u0629 \u062c\u062f\u064a\u062f\u0629","PromoPageNameCannotChange": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u063a\u064a\u064a\u0631 \u0627\u0633\u0645 \u0635\u0641\u062d\u0629 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0631\u0648\u064a\u062c\u064a. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0632\u0631 \u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u062d\u062a\u0648\u0649.","headersPageNameCannotChange": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u063a\u064a\u064a\u0631 \u0627\u0633\u0645 \u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0624\u0648\u0633. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0632\u0631 \u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u062d\u062a\u0648\u0649.","addNewCategory": "\u0625\u0636\u0627\u0641\u0629 \u0641\u0626\u0629 \u062c\u062f\u064a\u062f\u0629","CategoryNameExplanation": "\u0646\u0638\u0651\u0645 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0636\u0645\u0646 \u0641\u0626\u0629.","CategoryNamePlaceholder": "\u0645\u062b\u0627\u0644: \u0627\u0644\u062e\u062f\u0645\u0627\u062a\u060c \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a\u060c \u0645\u0646 \u0646\u062d\u0646","showOnPagesMenu": "\u064a\u062d\u062f\u062f \u0647\u0630\u0627 \u0627\u0644\u0636\u0628\u0637 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0631\u0623\u0633 \u0627\u0644\u0645\u0648\u0642\u0639","showOnFooterExp": "\u064a\u062d\u062f\u062f \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u062a\u0630\u064a\u064a\u0644 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628.","Hide_page_from_users": "\u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0635\u0641\u062d\u0629 \u0639\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646","Hide_page_from_users_explain": "\u0635\u0641\u062d\u062a\u0643 \u0645\u062e\u0641\u064a\u0629 \u0639\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646. \u0644\u0627 \u064a\u0632\u0627\u0644 \u0628\u0625\u0645\u0643\u0627\u0646\u0643 \u0625\u062f\u0627\u0631\u062a\u0647\u0627 \u060c \u0648\u0644\u0643\u0646 \u0644\u0646 \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0631\u0624\u064a\u062a\u0647\u0627. \u0627\u0646\u0642\u0631 \u0641\u0648\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631.","Hide_page_from_users_disabled_tooltip": "\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0644\u0623\u0646 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0644\u0627 \u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629.","Your_page_is_hide_from_users": "\u0635\u0641\u062d\u062a\u0643 \u0645\u062e\u0641\u064a\u0629 \u0639\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646. \u0644\u0627 \u064a\u0632\u0627\u0644 \u0628\u0625\u0645\u0643\u0627\u0646\u0643 \u0625\u062f\u0627\u0631\u062a\u0647 \u060c \u0648\u0644\u0643\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0631\u0624\u064a\u062a\u0647. \u0627\u0646\u0642\u0631 \u0641\u0648\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631.","Your_page_is_hide_from_homepage": "\u062a\u0638\u0647\u0631 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0641\u0642\u0637. \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631.","pagesCategoryIcon": "\u0627\u0644\u0641\u0626\u0629","pagesRichpageIcon": "\u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645","changeStyleModal": {"title": "\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u062a\u062e\u0637\u064a\u0637","mainTab": "\u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629","contentTab": "\u0645\u062d\u062a\u0648\u0649",},"layoutCategory": {"standard": "\u0627\u0633\u0627\u0633\u064a","forms": "\u0623\u0634\u0643\u0627\u0644","mockup": "\u0646\u0645\u0648\u0630\u062c \u062a\u0635\u0645\u064a\u0645",},"shownOnHomepage": "\u064a\u062d\u062f\u062f \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629.","shownOnHomepageSinglePage": "\u064a\u062d\u062f\u062f \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629. \u0641\u064a \u0646\u0648\u0639 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u0645\u0643\u0648\u0646 \u0645\u0646 \u0635\u0641\u062d\u0629 \u0648\u0627\u062d\u062f\u0629 \u060c \u064a\u0643\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0625\u0644\u0632\u0627\u0645\u064a\u064b\u0627 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0639\u0637\u064a\u0644\u0647. \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u063a\u0628 \u0641\u064a \u062a\u0639\u0637\u064a\u0644 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u060c \u064a\u0631\u062c\u0649 \u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0625\u0644\u0649 \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0635\u0641\u062d\u0627\u062a.","shownOnHeaderLandingPage": "\u064a\u062d\u062f\u062f \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u0631\u0623\u0633 \u0623\u0645 \u0644\u0627. \u0641\u064a \u0646\u0648\u0639 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0647\u0628\u0648\u0637\u060c \u064a\u0643\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0645\u0639\u0637\u0644\u0627\u064b.","shownOnSeperatedPage": "\u062a\u062d\u062f\u062f \u0647\u0630\u0647 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0635\u0641\u062d\u0629 \u0633\u062a\u0638\u0647\u0631 \u0643\u0635\u0641\u062d\u0629 \u0645\u0646\u0641\u0635\u0644\u0629 \u0648\u0641\u064a \u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0646\u0642\u0644.","ReadMore": "\u0627\u0642\u0631\u0623 \u0627\u0644\u0645\u0632\u064a\u062f","sorryGotError": "\u0639\u0630\u0631\u0627\u064b\u060c \u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062d\u0641\u0638 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a.","Homepage": "\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629","editHomepageText": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u062f\u064a\u0644 \u0646\u0635 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u062e\u0644\u0641\u064a\u062a\u0647\u0627. \u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u0644\u0648\u0627\u0646 \u0645\u0648\u0642\u0639\u0643 \u0648\u062e\u0637\u0648\u0637\u0647.","Pages": "\u0627\u0644\u0635\u0641\u062d\u0627\u062a\u202a","useReadyMadeModules": "\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062c\u0627\u0647\u0632\u0629 \u0644\u0625\u0646\u0634\u0627\u0621 \u0645\u0648\u0642\u0639\u0643 \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628. \u0645\u0627 \u0639\u0644\u064a\u0643 \u0633\u0648\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u064a\u0647 \u0648\u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.","Design": "\u0627\u0644\u062a\u0635\u0645\u064a\u0645","designCustomize": "\u0623\u0646\u0634\u0626 \u0645\u0648\u0642\u0639