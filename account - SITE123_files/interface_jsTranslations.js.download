u0644\u0645\u062d\u062f\u062f\u0629","deleteSelectedItemsAlert" 	: "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u062e\u062a\u0627\u0631\u0629\u061f","archiveSelectedItems" 		: "\u0623\u0631\u0634\u0641\u0629 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u062d\u062f\u062f\u0629","unarchiveSelectedItems" 	: "\u0625\u0644\u063a\u0627\u0621 \u0623\u0631\u0634\u0641\u0629 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u062d\u062f\u062f\u0629","archiveSelectedItemsAlert" : "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u0631\u063a\u0628\u062a\u0643 \u0641\u064a \u0623\u0631\u0634\u0641\u0629 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u062d\u062f\u062f\u0629\u061f","visible" 					: "\u0645\u0631\u0626\u064a","invisible" 				: "\u063a\u064a\u0631 \u0645\u0631\u0626\u0649","saveUpdateSuccessful" 		: "\u062a\u0645 \u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0628\u0646\u062c\u0627\u062d","eit_Save" 					: "\u062d\u0641\u0638","eit_SaveClose" 			: "\u062d\u0641\u0638 & \u062a\u0645","eit_SaveStay" 				: "\u062d\u0641\u0638 \u0648\u0627\u0644\u0628\u0642\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629","eit_Cancel" 				: "\u0625\u0644\u063a\u0627\u0621","KeepEditThePage" 			: "\u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0635\u0641\u062d\u0629","eit_View"                  : "\u0645\u0639\u0627\u064a\u0646\u0629","AreSureCloseWin"           : "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0641\u0630\u0629\u061f","PleaseMakeSaveChangeBefore": "\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u062d\u0641\u0638 \u062a\u063a\u064a\u064a\u0631\u0627\u062a\u0643 \u0645\u0646 \u0642\u0628\u0644","SureDiscardChanges"        : "\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u062a\u062c\u0627\u0647\u0644 \u062a\u063a\u064a\u064a\u0631\u0627\u062a\u0643\u061f","PleaseMakeSaveChangeBeforeLeave": "\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u062d\u0641\u0638 \u062a\u063a\u064a\u064a\u0631\u0627\u062a\u0643 \u0642\u0628\u0644 \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629.","DiscardChanges"            : "\u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a","autocompleteAddNewValue"   : "\u0623\u0636\u0641: \"{{value}}\"","moduleLimitedToOne"        : "{{page_name}} \u0645\u0648\u062c\u0648\u062f \u0628\u0627\u0644\u0641\u0639\u0644 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639. \u064a\u064f\u0631\u062c\u0649 \u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u0645 \u0622\u062e\u0631 \u0644\u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629.","requiredModuleMissing"     : "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0636\u0627\u0641\u0629 {{page_name}} \u0642\u0628\u0644 \u0625\u0636\u0627\u0641\u0629 {{parent_page_name}}","day"                       : "\u064a\u0648\u0645","days"                      : "\u0623\u064a\u0627\u0645","week"                      : "\u0623\u0633\u0628\u0648\u0639","weeks"                     : "\u0623\u0633\u0627\u0628\u064a\u0639","ThisOfferExpire"           : "\u0644\u0644\u0623\u0633\u0641 \u060c \u0627\u0646\u062a\u0647\u062a \u0635\u0644\u0627\u062d\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u0639\u0631\u0636.","pagesLimitHeader"          : "\u062d\u062f\u0648\u062f \u0627\u0644\u0635\u0641\u062d\u0629","pagesLimitMessage"         : "\u064a\u0642\u062a\u0635\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0644\u0649 \u0639\u062f\u062f {{limited_pages_number}} \u0635\u0641\u062d\u0629 \u0643\u062d\u062f \u0623\u0642\u0635\u0649. \u0644\u0625\u0636\u0627\u0641\u0629 \u0635\u0641\u062d\u0629 \u0623\u062e\u0631\u0649 \u060c \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u062d\u0630\u0641 \u0635\u0641\u062d\u0629 \u0645\u0648\u062c\u0648\u062f\u0629.","freePagesLimitHeader"      : "\u062a\u0642\u062a\u0635\u0631 \u0627\u0644\u062d\u0632\u0645\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0639\u0644\u0649 \u0635\u0641\u062d\u0627\u062a {{limited_pages_number}}.","freePagesLimitMessage"     : "\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0625\u0644\u0649 \u0625\u062d\u062f\u0649 \u0628\u0627\u0642\u0627\u062a\u0646\u0627 \u0627\u0644\u0645\u0645\u064a\u0632\u0629 \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u060c \u0623\u0648 \u062d\u0630\u0641 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u063a\u064a\u0631 \u0627\u0644\u0636\u0631\u0648\u0631\u064a\u0629 \u0645\u0646 \u0645\u0648\u0642\u0639\u0643 \u0639\u0644\u0649 \u0627\u0644\u0648\u064a\u0628.","freePagesLimitMessage_GO_PREMIUM"     : "\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0641\u064a!","freePagesLimitMessage_Not_now"     : "\u0644\u064a\u0633 \u0627\u0644\u0627\u0646.","proFeaturelimited"         : "\u0639\u0630\u0631\u064b\u0627 \u060c \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0645\u062a\u0627\u062d \u0641\u0642\u0637 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u064a\u0646. \u0627\u0646\u0642\u0631 \u0644\u0644\u062a\u0631\u0642\u064a\u0629.","premium"         : "+ \u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u064a\u0632\u0629","SorryDomainNotValid"         : "\u0639\u0630\u0631\u064b\u0627\u060c {{domain}} \u0644\u064a\u0633 \u0627\u0633\u0645 \u0646\u0637\u0627\u0642 \u0635\u0627\u0644\u062d\u064b\u0627. \u064a\u064f\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645 \u0646\u0637\u0627\u0642 \u0635\u0627\u0644\u062d (a-z, A-Z, 0-9, -).","SorryDomainIsSubDomain"         : "\u0639\u0630\u0631\u064b\u0627\u060c {{domain}} \u0647\u0648 \u0646\u0637\u0627\u0642 \u0641\u0631\u0639\u064a\u061b \u0644\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u062d\u062a\u0648\u064a \u0627\u0633\u0645 \u0627\u0644\u0646\u0637\u0627\u0642 \u0639\u0644\u0649 \u0646\u0642\u0637\u0629.","minimumDomainLength"         : "\u064a\u062c\u0628 \u0623\u0644\u0627 \u064a\u0642\u0644 \u0637\u0648\u0644 \u0627\u0633\u0645 \u0627\u0644\u0646\u0637\u0627\u0642 \u0639\u0646 {{domain_length}}.","YesDomainAvailable"         : "\u0646\u0639\u0645! \u0627\u0633\u0645 \u0646\u0637\u0627\u0642\u0643 \u0645\u062a\u0648\u0641\u0631","SorryDomainNotAva"         : "\u0646\u0623\u0633\u0641\u060c {{domainName}} \u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631.","DragThePageToAnotherPage"         : "\u064a\u0645\u0643\u0646\u0643 \u0633\u062d\u0628 \u0627\u0644\u0635\u0641\u062d\u0629 \u0625\u0644\u0649 \u0645\u0648\u0636\u0639 \u0622\u062e\u0631.","ChangeLayoutDesignOfPage"         : "\u062a\u063a\u064a\u064a\u0631 \u062a\u0635\u0645\u064a\u0645 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0635\u0641\u062d\u0629.","ChooseWhereLocate"         : "\u0627\u062e\u062a\u0631 \u0645\u0648\u0642\u0639 \u0627\u0644\u0635\u0641\u062d\u0629 \u0648\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0623\u062e\u0631\u0649 \u060c \u0645\u062b\u0644 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b.","UpdateManageContent"         : "\u062a\u062d\u062f\u064a\u062b \u0648\u0625\u062f\u0627\u0631\u0629 \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0635\u0641\u062d\u0629.","moreFontsUpgradeMsg": "\u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 100 \u062e\u0637","freeFontsList": "\u0627\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u062d\u0631\u0629","welcomeMessage": "<b>\u0645\u0631\u062d\u0628\u064b\u0627!<\/b> \u0625\u0630\u0627 \u0643\u0646\u062a\u0645 \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629\u060c \u0641\u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645 \u0644\u062f\u064a\u0646\u0627 \u0647\u0646\u0627 \u2014 \u0631\u0627\u0633\u0644\u0648\u0646\u0627 \u0641\u064a \u0623\u064a \u0648\u0642\u062a.","howCanWeHelp": "\u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0645\u0639 \u0627\u0644\u062f\u0639\u0645","wizardLanguageReload": "\u064a\u062a\u0637\u0644\u0628 \u062a\u063a\u064a\u064a\u0631 \u0644\u063a\u0629 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062a\u062d\u062f\u064a\u062b \u0645\u062a\u0635\u0641\u062d\u0643. \u0633\u0648\u0641 \u064a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0623\u0645\u0631 \u0633\u0648\u0649 \u0628\u0636\u0639 \u062b\u0648\u0627\u0646.","wizardWebsiteTypeReload": "\u064a\u062a\u0637\u0644\u0651\u0628 \u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0648\u0642\u0639 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u062a\u0635\u0641\u062d. \u0644\u0646 \u064a\u0633\u062a\u063a\u0631\u0642 \u0630\u0644\u0643 \u0633\u0648\u0649 \u0628\u0636\u0639 \u062b\u0648\u0627\u0646\u064d.<br><br>\u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","wizardWebsiteTypeReloadMultiPagesV2": "<b>\u062a\u062d\u0630\u064a\u0631:<\/b> \u0642\u062f \u064a\u0624\u062f\u064a \u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0648\u0642\u0639 \u0625\u0644\u0649 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0643\u0628\u064a\u0631\u0629 \u0641\u064a \u0628\u0646\u064a\u0629 \u0645\u0648\u0642\u0639\u0643. \u0642\u062f \u062a\u062a\u0623\u062b\u0631 \u0628\u0639\u0636 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0648\u0639\u0646\u0627\u0648\u064a\u0646 URL \u0648\u0627\u0644\u0645\u062d\u062a\u0648\u0649. \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0648\u062d\u064a\u062f\u0629 \u0644\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0647\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0632\u0631 \u00ab\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646\u00bb \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0631 \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0645\u0648\u0642\u0639\u0643 \u0625\u0644\u0649 \u0625\u0635\u062f\u0627\u0631 \u0633\u0627\u0628\u0642.<br><br>\u064a\u062a\u0637\u0644\u0628 \u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u062a\u0635\u0641\u062d. \u0644\u0646 \u064a\u0633\u062a\u063a\u0631\u0642 \u0630\u0644\u0643 \u0633\u0648\u0649 \u0628\u0636\u0639 \u062b\u0648\u0627\u0646\u064d.<br><br>\u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f","loadmore": "\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0632\u064a\u062f","undo": "\u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 {{shortcut}}","redo": "\u0625\u0639\u0627\u062f\u0629 {{shortcut}}","Templates": "\u0642\u0648\u0627\u0644\u0628","TemplatesTabExplain": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0644\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646 \u0628\u064a\u0646\u0647\u0627 \u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643. \u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0642\u0627\u0644\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0628\u0646\u0642\u0631\u0629!","fontsSearchNoResult": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0646\u062a\u0627\u0626\u062c","fontFilterNoResult": "\u0644\u0627 \u062a\u0648\u062c\u062f \u062e\u0637\u0648\u0637 \u062a\u0637\u0627\u0628\u0642 \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643. \u062c\u0631\u0651\u0628 \u062a\u0639\u062f\u064a\u0644 \u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u062a\u0635\u0641\u064a\u0629.","fontsSearchPlaceHolder": "\u0628\u062d\u062b \u0627\u0644\u062e\u0637\u0648\u0637","filterFonts": "\u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u062e\u0637\u0648\u0637","fontType": "\u0646\u0648\u0639 \u0627\u0644\u062e\u0637","singleFont": "\u062e\u0637 \u0648\u0627\u062d\u062f","fontCombination": "\u0645\u0632\u064a\u062c","italicSupport": "\u062f\u0639\u0645 \u0627\u0644\u062e\u0637 \u0627\u0644\u0645\u0627\u0626\u0644","languages": "\u0627\u0644\u0644\u063a\u0627\u062a","subsets": "\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0623\u062d\u0631\u0641","feeling": "\u0627\u0644\u0637\u0627\u0628\u0639","appearance": "\u0627\u0644\u0645\u0638\u0647\u0631","tips_PagesTabDrag": "\u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0645\u0648\u0636\u0639 \u0635\u0641\u062d\u0627\u062a\u0643 \u0648\u062a\u0631\u062a\u064a\u0628\u0647\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u064a\u0647\u0627 \u0648\u0633\u062d\u0628\u0647\u0627.","tips_PreviewManageButtons": "\u064a\u0645\u0643\u0646\u0643 \u0625\u062f\u0627\u0631\u0629 \u0648\u062a\u0635\u0645\u064a\u0645 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0647\u0630\u0647.","tips_UnderstandBtn": "\u0623\u0646\u0627 \u0623\u0641\u0647\u0645.","slogan": "\u0627\u0644\u0634\u0639\u0627\u0631 \u0627\u0644\u0646\u0635\u064a","seo": "SEO","italic": {"notSupported": "\u0627\u0644\u062e\u0637 \u0627\u0644\u0645\u062d\u062f\u062f \u0644\u0627 \u064a\u062f\u0639\u0645 \u0627\u0644\u062e\u0637 \u0627\u0644\u0645\u0627\u0626\u0644","supported": "\u0645\u0627\u0626\u0644",},"advancedSEO": {"customSEOTitle": "SEO \u0645\u062e\u0635\u0635","customSEOTooltip": "\u064a\u0642\u0648\u0645 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0625\u0646\u0634\u0627\u0621 \u0639\u0644\u0627\u0645\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0644\u0623\u062f\u0648\u0627\u062a \u0645\u062d\u0631\u062c\u0627\u062a \u0627\u0644\u0628\u062d\u062b - \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u062f\u0627\u0629 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u064a\u064a\u0646 \u0639\u0644\u0627\u0645\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0645\u062e\u0635\u0635\u0629.","title": {"title" : "\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629 \u0627\u0644\u0639\u0646\u0648\u0627\u0646","placeholder" : "\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629 \u0627\u0644\u0639\u0646\u0648\u0627\u0646","tooltip" : "\u064a\u0646\u0638\u0631 \u0625\u0644\u064a\u0647\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0645\u0633\u062a\u062e\u062f\u0645\u064a \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u062d\u062b \u060c \u0643\u0645\u0627 \u0623\u0646\u0647\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0645\u0646 \u0642\u0628\u0644 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0641\u0647\u0631\u0633\u0629 \u0627\u0644\u0645\u0648\u0642\u0639.",},"generateSEOWithAI": "\u0625\u0646\u0634\u0627\u0621 \u0648\u0633\u0648\u0645 SEO \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a","generatingSEOWithAI": "\u062c\u0627\u0631\u064d \u0625\u0646\u0634\u0627\u0621 \u0639\u0644\u0627\u0645\u0627\u062a SEO...","description": {"title" : "\u0648\u0635\u0641 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629","placeholder" : "\u0648\u0635\u0641 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629","tooltip" : "\u064a\u0642\u062f\u0645 \u0645\u0644\u062e\u0635\u0627 \u0644\u0645\u0627 \u0647\u0648 \u0645\u0648\u0642\u0639\u0643. \u0633\u064a\u0638\u0647\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u062e\u0635 \u0623\u0633\u0641\u0644 \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u0632\u0631\u0642\u0627\u0621 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0646\u0642\u0631 \u0641\u064a \u0635\u0641\u062d\u0629 \u0646\u062a\u0627\u0626\u062c \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u062d\u062b.",},"url": {"title" : "\u0631\u0627\u0628\u0637 \u0627\u0644\u0635\u0641\u062d\u0629","placeholder" : "\u0631\u0627\u0628\u0637 \u0627\u0644\u0635\u0641\u062d\u0629","tooltip" : "\u064a\u062a\u064a\u062d \u0644\u0643 \u062a\u063a\u064a\u064a\u0631 \u0639\u0646\u0648\u0627\u0646 URL \u0644\u0644\u0635\u0641\u062d\u0629.",},"keywords": {"title" : "\u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0644\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629 (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u060c \u0639\u0637\u0644\u0629 \u060c \u0631\u062d\u0644\u0629 \u060c \u0641\u0646\u0627\u062f\u0642)","placeholder" : "\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u0639\u0637\u0644\u0629 \u060c \u0631\u062d\u0644\u0629 \u060c \u0641\u0646\u0627\u062f\u0642","tooltip" : "\u064a\u0642\u062f\u0645 \u0645\u0644\u062e\u0635\u064b\u0627 \u0644\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u0633\u062a\u0647\u062f\u0641\u0647\u0627 \u0627\u0644\u0645\u0648\u0642\u0639. \u064a\u0633\u0627\u0639\u062f \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0639\u0644\u0649 \u0641\u0647\u0645 \u0645\u062d\u062a\u0648\u0649 \u0645\u0648\u0642\u0639\u0643 \u0628\u0634\u0643\u0644 \u0623\u0641\u0636\u0644.",},"image": {"title" : "\u0635\u0648\u0631\u0629 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629"		},"pageTitleHandlerMsg": "\u0644\u0642\u062f \u063a\u064a\u0651\u0631\u062a \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0635\u0641\u062d\u0629. \u064a\u064f\u0631\u062c\u0649 \u062a\u0639\u062f\u064a\u0644 \u0625\u0639\u062f\u0627\u062f\u0627\u062a SEO \u0623\u064a\u0636\u064b\u0627.","metaDescriptionTagExample": "\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0644\u0627\u0645\u0629 \u0648\u0635\u0641 \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u0644\u062e\u064a\u0635 \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0635\u0641\u062d\u0629. \u062a\u0633\u062a\u062e\u062f\u0645 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0623\u062d\u064a\u0627\u0646\u064b\u0627 \u0647\u0630\u0647 \u0627\u0644\u0645\u0642\u062a\u0637\u0641\u0627\u062a \u0641\u064a \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0628\u062d\u062b \u0644\u0644\u0633\u0645\u0627\u062d \u0644\u0644\u0632\u0627\u0626\u0631\u064a\u0646 \u0628\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u064a \u062a\u062f\u0648\u0631 \u062d\u0648\u0644\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u0646\u0642\u0631 \u0641\u0648\u0642\u0647\u0627.","metaTitleTagExample": "\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629 \u0644\u0644\u0639\u0646\u0648\u0627\u0646 - \u0639\u0646\u0648\u0627\u0646 \u0635\u0641\u062d\u062a\u0643","remaining": "\u0645\u062a\u0628\u0642","noindex": {"title" : "\u0625\u062e\u0641\u0627\u0621 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b.","tooltipForItem" : "\u0625\u062e\u0641\u0627\u0621 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0646 \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b (\u0623\u0636\u0641 \u0639\u0644\u0627\u0645\u0629 noindex \u0627\u0644\u0648\u0635\u0641\u064a\u0629).","tooltipForModule" : "\u0625\u062e\u0641\u0627\u0621 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0646 \u0646\u062a\u0627\u0626\u062c \u0645\u062d\u0631\u0643 \u0627\u0644\u0628\u062d\u062b (\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629 noindex). \u0644\u0646 \u064a\u0624\u062b\u0631 \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0639\u0644\u0649 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0636\u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u060c \u0644\u0646 \u064a\u0624\u062b\u0631 \u0625\u062e\u0641\u0627\u0621 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062a\u062c\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u060c \u0648\u0644\u0646 \u064a\u0624\u062b\u0631 \u0625\u062e\u0641\u0627\u0621 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a\u060c \u0648\u0645\u0627 \u0625\u0644\u0649 \u0630\u0644\u0643. \u0644\u0625\u062e\u0641\u0627\u0621 \u0639\u0646\u0635\u0631 \u060c \u064a\u0644\u0632\u0645 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0640 \u0643\u0644 \u0639\u0646\u0635\u0631 \u0648\u0625\u062e\u0641\u0627\u0626\u0647 \u0639\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u064a\u062f\u0648\u064a\u064b\u0627.",},"pageUrlExitsModelTitle": "\u0639\u0646\u0648\u0627\u0646 URL \u0644\u0635\u0641\u062d\u0629 SEO","validFriendlyURL": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645 \u0635\u0641\u062d\u0629 \u0635\u0627\u0644\u062d \u0648\u0645\u0646\u0627\u0633\u0628 \u0644\u0639\u0646\u0648\u0627\u0646 URL.","longDescriptionNotActive": "\u064a\u062a\u0648\u0641\u0631 SEO \u0627\u0644\u0645\u062a\u0642\u062f\u0645 \u0641\u0642\u0637 \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u062e\u064a\u0627\u0631 \"\u0635\u0641\u062d\u0629 \u0641\u0631\u064a\u062f\u0629\".","externalLinkNotSupported": "\u0645\u064a\u0632\u0629 SEO \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0645\u062a\u0627\u062d\u0629 \u0641\u0642\u0637 \u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0641\u0631\u064a\u062f\u060c \u0648\u0644\u064a\u0633\u062a \u0644\u0644\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629.","noContentEntered": "\u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u062e\u064a\u0627\u0631\u0627\u062a SEO \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0625\u0644\u0627 \u0628\u0639\u062f \u062a\u0641\u0639\u064a\u0644 \u062d\u0642\u0644 \u00ab\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0641\u0631\u064a\u062f\u00bb \u0648\u0625\u062f\u062e\u0627\u0644 \u0645\u062d\u062a\u0648\u0649 \u0641\u064a\u0647.","uniquePageRequired": "\u064a\u062a\u0648\u0641\u0631 SEO \u0627\u0644\u0645\u062a\u0642\u062f\u0645 \u0641\u0642\u0637 \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u062e\u064a\u0627\u0631 \"\u0635\u0641\u062d\u0629 \u0641\u0631\u064a\u062f\u0629\" \u0645\u0639 \"\u0645\u062d\u062a\u0648\u0649 \u0641\u0631\u064a\u062f\".",},"homepageRI": {"patterns": "\u064a\u064f\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0623\u062d\u0631\u0641 \u0623\u0628\u062c\u062f\u064a\u0629 \u063a\u064a\u0631 \u0645\u064f\u0634\u0643\u0651\u0644\u0629 \u0623\u0648 \u0623\u0631\u0642\u0627\u0645 \u0623\u0648 \u0634\u0631\u0637\u0627\u062a \u0623\u0648 \u0645\u0633\u0627\u0641\u0627\u062a \u0641\u0642\u0637 (a-z\u060c 0-9\u060c -\u060c \u0645\u0633\u0627\u0641\u0629).","placeholder": "\u0628\u062d\u062b \u0627\u0644\u0635\u0648\u0631","typeColorTitle": "\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0644\u0648\u0646","typeGradientsTitle": "\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u062a\u062f\u0631\u062c","typeImagesTitle": "\u0627\u062e\u062a\u0631 \u0635\u0648\u0631\u0629","typeCategoriesTitle": "\u0627\u062e\u062a\u0631 \u0641\u0626\u0629","typePatternsTitle": "\u0627\u062e\u062a\u064a\u0627\u0631 \u0646\u0645\u0637","all": "\u0627\u0644\u0643\u0644","saveAndClose": "\u0625\u063a\u0644\u0627\u0642 \u0648\u0645\u062a\u0627\u0628\u0639\u0629","noResultsFound": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0646\u062a\u0627\u0626\u062c.","savedLabel": "\u062a\u0645 \u0627\u0644\u062d\u0641\u0638","creditsPhotographerName": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0635\u0648\u0631:","creditsProvider": "\u0627\u0644\u0645\u0632\u0648\u062f:","creditsSeeMoreDetails": "\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644"	},"homepageChangingImages": {"enabled": "\u0625\u0636\u0627\u0641\u0629 \u062e\u0644\u0641\u064a\u0629 \u062c\u062f\u064a\u062f\u0629","disabled": "\u0639\u0631\u0636 \u0627\u0644\u0634\u0631\u0627\u0626\u062d \u0645\u062d\u062f\u0648\u062f \u0628\u0640 {{maxAmount}} \u0639\u0646\u0627\u0635\u0631","colors": "\u0627\u0644\u0623\u0644\u0648\u0627\u0