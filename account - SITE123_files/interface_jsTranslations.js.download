27\u062a \u0625\u0644\u064a\u0647.","pageNamePlaceholder": "\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: \u0645\u0646 \u0646\u062d\u0646\u060c \u062e\u062f\u0645\u0627\u062a\u0646\u0627\u060c \u0645\u0639\u0631\u0636 \u0627\u0644\u0623\u0639\u0645\u0627\u0644","convertTitle": "\u062a\u062d\u0648\u064a\u0644 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645","convertQuestion": "\u0633\u064a\u0624\u062f\u064a \u0646\u0642\u0644 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0625\u0644\u0649 \u0625\u062e\u0641\u0627\u0626\u0647\u0627 \u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621. \u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u061f","convertTooltip": "\u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0647\u064a \u0635\u0641\u062d\u0629 \u064a\u0645\u0643\u0646\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644\u0647\u0627 \u0625\u0636\u0627\u0641\u0629 \u0623\u0642\u0633\u0627\u0645 \u0625\u0644\u064a\u0647\u0627.","cancel": "\u0625\u0644\u063a\u0627\u0621","save": "\u062d\u0641\u0638","backBtn": "\u0627\u0644\u0635\u0641\u062d\u0627\u062a\u202a","unSupportedModule": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0636\u0627\u0641\u0629 {{page_name}} \u0625\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645.","warningMessageTitle": "\u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0625\u0639\u0644\u0627\u0645 \u0627\u0644\u0635\u0641\u062d\u0629","warningMessage": "\u0644\u0627\u062d\u0638\u0646\u0627 \u0623\u0646 \u0644\u062f\u064a\u0643 \u0623\u0642\u0633\u0627\u0645\u064b\u0627 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643. \u0644\u0646 \u062a\u0643\u0648\u0646 \u0645\u0631\u0626\u064a\u0629 \u062d\u062a\u0649 \u062a\u0642\u0648\u0645 \u0628\u062a\u063a\u064a\u064a\u0631 \u0646\u0648\u0639 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0625\u0644\u0649 Multipage \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","nameCannotChange": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u063a\u064a\u064a\u0631 \u0627\u0633\u0645 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0633\u0627\u0645. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0632\u0631 \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062c\u0645\u0639 \u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u062d\u062a\u0648\u0649.","showOnHomepageDisabled": "\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0647\u0630\u0647 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0644\u0623\u0646\u0647 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0639\u0631\u0636 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629.","promoFistChildError": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u062a\u0631\u0648\u064a\u062c\u064a\u0629 \u0647\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0641\u064a \u0635\u0641\u062d\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u0642\u0633\u0627\u0645.","headersFistChildError": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u063