25\u0636\u0627\u0641\u0627\u062a","addNewPlugin": "\u0625\u0636\u0627\u0641\u0629 \u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0633\u0627\u0639\u062f \u062c\u062f\u064a\u062f","packageChangeTitle": "\u0634\u0643\u0631\u0627 \u0644\u0644\u062a\u0631\u0642\u064a\u0629! \u064a\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.","packageChangeMessageWizard": "\u0645\u0628\u0631\u0648\u0643 \u0639\u0644\u0649 \u062a\u0631\u0642\u064a\u0629 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643! \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u064a \u0628\u0627\u0642\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u060c \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0631. \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644.","packageChangeMessageDashboard": "\u0645\u0628\u0631\u0648\u0643 \u0639\u0644\u0649 \u062a\u0631\u0642\u064a\u0629 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643! \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u064a \u0628\u0627\u0642\u062a\u0643  \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u060c \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629. \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644.","pageSeoTool": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u062f\u064a\u0644 \u062a\u062d\u0633\u064a\u0646 \u0645\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0644\u0635\u0641\u062d\u062a\u0643.","pageSloganTool": "\u0647\u0646\u0627 \u064a\u0645\u0643\u0646\u0643 \u0625\u0636\u0627\u0641\u0629 \u0634\u0639\u0627\u0631 \u0633\u064a\u0638\u0647\u0631 \u062a\u062d\u062a \u0639\u0646\u0648\u0627\u0646 \u0635\u0641\u062d\u062a\u0643.","packageChangeTitle": "\u0634\u0643\u0631\u0627 \u0644\u0644\u062a\u0631\u0642\u064a\u0629! \u064a\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.","packageChangeMessageWizard": "\u0645\u0628\u0631\u0648\u0643 \u0639\u0644\u0649 \u062a\u0631\u0642\u064a\u0629 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643! \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u064a \u0628\u0627\u0642\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u060c \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u062d\u0631\u0631. \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644.","packageChangeMessageDashboard": "\u0645\u0628\u0631\u0648\u0643 \u0639\u0644\u0649 \u062a\u0631\u0642\u064a\u0629 \u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u064a\u0628 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643! \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u064a \u0628\u0627\u0642\u062a\u0643  \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u060c \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629. \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644.","existingFiles": "\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629","noExistingFiles": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0644\u0641\u0627\u062a \u0645\u0648\u062c\u0648\u062f\u0629","existingFilesModal": {"editFile": "\u062a\u062d\u0631\u064a\u0631","uploadMedia": "\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0648\u0633\u0627\u0626\u0637","filterByType": "\u062a\u0635\u0641\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639","image": "\u0627\u0644\u0635\u0648\u0631\u0629","video": "\u0641\u064a\u062f\u064a\u0648","pdf": "PDF","audio": "\u0633\u0645\u0639\u064a","document": "\u0648\u062b\u064a\u0642\u0629","zip": "ZIP"	},"generateWithAI":{"warning": "\u062a\u062d\u0630\u064a\u0631","videoNotAvailableTooltip": "\u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u062d\u062a\u0649 \u0646\u0646\u062a\u0647\u064a \u0645\u0646 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648.","videoGenerateFailed": "\u0641\u0634\u0644 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648: \u062a\u0645 \u062d\u0638\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u064f\u0646\u0634\u0623 \u0628\u0648\u0627\u0633\u0637\u0629 \u0641\u0644\u0627\u062a\u0631 \u0645\u062d\u062a\u0648\u0649 Google.","Reason": "\u0627\u0644\u0633\u0628\u0628","videoGenerateFailedTooltip2": "\u064a\u0631\u062c\u0649 \u062a\u062c\u0631\u0628\u0629 \u0645\u064f\u062f\u062e\u0644 \u0623\u0648 \u0635\u0648\u0631\u0629 \u0645\u062e\u062a\u0644\u0641\u0629.","videoNotAvailable": "\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u0644\u0647\u0630\u0647 \u0627\u0644\u0635\u0648\u0631\u0629","videoNotAvailableTooltip": "\u0647\u0630\u0647 \u0627\u0644\u0648\u062d\u062f\u0629 \u0644\u0627 \u062a\u062f\u0639\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648.","videoGenerateError": "\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","noVideoToSave": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0641\u064a\u062f\u064a\u0648 \u0644\u0644\u062d\u0641\u0638","error": "\u062e\u0637\u0623","savingVideo": "\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0641\u0638","describeVideo": "\u0635\u0650\u0641 \u062d\u0631\u0643\u0629 \u0627\u0644\u0641\u064a\u062f\u064a\u0648","aspectRatio": "\u0646\u0633\u0628\u0629 \u0627\u0644\u0639\u0631\u0636 \u0625\u0644\u0649 \u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639","cinematic": "\u0633\u064a\u0646\u0645\u0627\u0626\u064a","dramatic": "\u062f\u0631\u0627\u0645\u064a","dreamy": "\u062d\u064f\u0644\u064f\u0645\u064a","dynamic": "\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a","smooth": "\u0633\u064e\u0644\u0650\u0633","epic": "\u0645\u0644\u062d\u0645\u064a","video": "\u0641\u064a\u062f\u064a\u0648","landscape": "\u0627\u0644\u0645\u0646\u0627\u0638\u0631 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629","portrait": "\u0644\u0648\u062d\u0629","generateVideo": "\u0625\u0646\u0634\u0627\u0621 \u0641\u064a\u062f\u064a\u0648","saveVideo": "\u062d\u0641\u0638 \u0627\u0644\u0641\u064a\u062f\u064a\u0648","smoothZoomInWithCinematicLighting": "\u062a\u0642\u0631\u064a\u0628 \u0633\u0644\u0633 \u0645\u0639 \u0625\u0636\u0627\u0621\u0629 \u0633\u064a\u0646\u0645\u0627\u0626\u064a\u0629","gentlePanFromLeftToRightWithNaturalMotion": "\u062a\u062d\u0631\u064a\u0643 \u0647\u0627\u062f\u0626 \u0644\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0645\u0646 \u0627\u0644\u064a\u0633\u0627\u0631 \u0625\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646 \u0628\u062d\u0631\u0643\u0629 \u0637\u0628\u064a\u0639\u064a\u0629","dramaticCameraMovementBringingTheSceneToLife": "\u062d\u0631\u0643\u0629 \u0643\u0627\u0645\u064a\u0631\u0627 \u062f\u0631\u0627\u0645\u064a\u0629 \u062a\u064f\u062d\u064a\u064a \u0627\u0644\u0645\u0634\u0647\u062f","slowCinematicRevealWithDepthAndAtmosphere": "\u0643\u0634\u0641 \u0633\u064a\u0646\u0645\u0627\u0626\u064a \u0628\u0637\u064a\u0621 \u0645\u0639 \u0639\u0645\u0642 \u0648\u0623\u062c\u0648\u0627\u0621","zoomIn": "\u062a\u0643\u0628\u064a\u0631","panLeftToRight": "\u0627\u0633\u062d\u0628 \u0645\u0646 \u0627\u0644\u064a\u0633\u0627\u0631 \u0625\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646","dynamicMovement": "\u062d\u0631\u0643\u0629 \u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629","cinematicReveal": "\u0643\u0634\u0641 \u0633\u064a\u0646\u0645\u0627\u0626\u064a","makeItLive": "\u0627\u0646\u0634\u0631\u0647 \u0627\u0644\u0622\u0646","quickIdeas": "\u0623\u0641\u0643\u0627\u0631 \u0633\u0631\u064a\u0639\u0629:","quickStyles": "\u0623\u0646\u0645\u0627\u0637 \u0633\u0631\u064a\u0639\u0629:","provider": "\u0645\u0632\u0648\u062f","providerTooltip": "\u0627\u062e\u062a\u0631 \u0645\u0632\u0648\u0651\u062f \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0635\u0648\u0631","title": "\u0625\u0646\u0634\u0627\u0621 \u0635\u0648\u0631\u0629 (\u0630\u0643\u0627\u0621 \u0627\u0635\u0637\u0646\u0627\u0639\u064a)","typeWhatYouWantToCreate": "\u0627\u0643\u062a\u0628 \u0645\u0627 \u062a\u0631\u064a\u062f \u0625\u0646\u0634\u0627\u0621\u0647","typeWhatYouWantToCreateTooltip": "\u0635\u0650\u0641 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u064a\u062f \u0625\u0646\u0634\u0627\u0621\u0647\u0627. \u0643\u0644\u0645\u0627 \u0643\u0627\u0646 \u0648\u0635\u0641\u0643 \u0623\u0643\u062b\u0631 \u062a\u0641\u0635\u064a\u0644\u0627\u064b\u060c \u0643\u0627\u0646\u062a \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0623\u0641\u0636\u0644.","examplePrompt": "\u0645\u062b\u0627\u0644: \u063a\u0631\u0648\u0628 \u062c\u0645\u064a\u0644 \u0641\u0648\u0642 \u0645\u062d\u064a\u0637 \u0647\u0627\u062f\u0626","imageStyle": "\u0646\u0645\u0637 \u0627\u0644\u0635\u0648\u0631\u0629","imageStyleTooltip": "\u0627\u062e\u062a\u0631 \u0646\u0645\u0637\u064b\u0627 \u0644\u062a\u0637\u0628\u064a\u0642\u0647 \u0639\u0644\u0649 \u0635\u0648\u0631\u062a\u0643 \u0627\u0644\u0645\u064f\u0646\u0634\u0623\u0629. \u0633\u064a\u0645\u0646\u062d \u0643\u0644 \u0646\u0645\u0637 \u0635\u0648\u0631\u062a\u0643 \u0645\u0638\u0647\u0631\u064b\u0627 \u0648\u0625\u062d\u0633\u0627\u0633\u064b\u0627 \u0641\u0646\u064a\u064b\u0627 \u0641\u0631\u064a\u062f\u064b\u0627.","imageSize": "\u062d\u062c\u0645 \u0627\u0644\u0635\u0648\u0631\u0629","imageSizeTooltip": "\u0627\u062e\u062a\u0631 \u0627\u0644\u0623\u0628\u0639\u0627\u062f \u0644\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u064f\u0648\u0644\u0651\u064e\u062f\u0629: \u0623\u0641\u0642\u064a\u060c \u0645\u0631\u0628\u0639\u060c \u0639\u0645\u0648\u062f\u064a","generate": "\u0625\u0646\u0634\u0627\u0621","generating": "\u062c\u0627\u0631\u064d \u0627\u0644\u0625\u0646\u0634\u0627\u0621...","generatedImageWillAppearHere": "\u0633\u062a\u0638\u0647\u0631 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0645 \u0625\u0646\u0634\u0627\u0624\u0647\u0627 \u0647\u0646\u0627","addImage": "\u0625\u0636\u0627\u0641\u0629 \u0635\u0648\u0631\u0629","enterDescription": "\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0648\u0635\u0641 \u0644\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u064a\u062f \u0625\u0646\u0634\u0627\u0621\u0647\u0627","ok": "\u0645\u0648\u0627\u0641\u0642","error": "\u062e\u0637\u0623","pleaseUpgradeYourPlanToGetMoreAICredits": "\u064a\u0631\u062c\u0649 \u0634\u0631\u0627\u0621 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0631\u0635\u064a\u062f \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629.","credits": "\u0623\u0631\u0635\u062f\u0629","creditsInfo": "\u064a\u062a\u0645 \u062e\u0635\u0645 \u0627\u0644\u0631\u0635\u064a\u062f \u0641\u064a \u0643\u0644 \u0639\u0645\u0644\u064a\u0629 \u0625\u0646\u0634\u0627\u0621 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0642\u0627\u0636\u0627\u0647\u0627 \u0645\u0632\u0648\u0651\u062f \u0627\u0644\u0640AI.","availableCredits": "\u0627\u0644\u0623\u0631\u0635\u062f\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629","unableToLoadCredits": "\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0631\u0635\u064a\u062f","loadingCredits": "\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0631\u0635\u064a\u062f","generatingVideo": "\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u0648\u0644\u064a\u062f","generatingVideoCosts": "\u064a\u062a\u0645 \u062e\u0635\u0645 \u0627\u0644\u0623\u0631\u0635\u062f\u0629 \u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u0641\u0631\u0636\u0647\u0627 \u0645\u0632\u0648\u0651\u062f \u0627\u0644\u0640AI.","notEnoughCredits": "\u0644\u0645 \u064a\u062a\u0628\u0642\u0651\u064e \u0644\u062f\u064a\u0643 \u0623\u064a \u0631\u0635\u064a\u062f. \u064a\u064f\u0631\u062c\u0649 \u0634\u0631\u0627\u0621 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0631\u0635\u064a\u062f \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629.","failedToGenerate": "\u0641\u0634\u0644 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0635\u0648\u0631\u0629. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","upgrade": "\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0631\u0635\u064a\u062f","upgradePlanTitle": "\u062e\u0637\u0629 \u0627\u0644\u062a\u0631\u0642\u064a\u0629","square": "\u0645\u064a\u062f\u0627\u0646","horizontal": "\u0639\u0631\u0636\u064a","vertical": "\u0639\u0645\u0648\u062f\u064a","madeOfStars": "\u0645\u0635\u0646\u0648\u0639 \u0645\u0646 \u0627\u0644\u0646\u062c\u0648\u0645","artDeco": "\u0622\u0631\u062a \u062f\u064a\u0643\u0648","caricature": "\u0643\u0627\u0631\u064a\u0643\u0627\u062a\u064a\u0631","minimalist": "\u0645\u064a\u0646\u064a\u0645\u0627\u0644\u064a","sculpture": "\u0646\u062d\u062a","duskLighting": "\u0625\u0636\u0627\u0621\u0629 \u0627\u0644\u063a\u0633\u0642","highContrast": "\u062a\u0628\u0627\u064a\u0646 \u0639\u0627\u0644\u064d","crayonStyle": "\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0623\u0642\u0644\u0627\u0645 \u0627\u0644\u0634\u0645\u0639\u064a\u0629","nineteenthCenturyLithographStyle": "\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u062d\u062c\u0631\u064a\u0629 \u0645\u0646 \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062a\u0627\u0633\u0639 \u0639\u0634\u0631","blackAndWhite": "\u0627\u0633\u0648\u062f \u0648 \u0627\u0628\u064a\u0636","madeOfGold": "\u0645\u0635\u0646\u0648\u0639 \u0645\u0646 \u0627\u0644\u0630\u0647\u0628","fairyTaleStyle": "\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u062d\u0643\u0627\u064a\u0627\u062a \u0627\u0644\u062e\u0631\u0627\u0641\u064a\u0629","pencilSketch": "\u0631\u0633\u0645 \u0628\u0627\u0644\u0642\u0644\u0645 \u0627\u0644\u0631\u0635\u0627\u0635","kawaii": "\u0643\u0627\u0648\u0627\u064a\u064a","lowPolygon": "\u0645\u0646\u062e\u0641\u0636 \u0627\u0644\u0645\u0636\u0644\u0639\u0627\u062a","mutedPalette": "\u0644\u0648\u062d\u0629 \u0623\u0644\u0648\u0627\u0646 \u0628\u0627\u0647\u062a\u0629","graffitiStyle": "\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u063a\u0631\u0627\u0641\u0